#!/usr/bin/env bash
set -eo pipefail

# Copilot Session Manager
# Global session tracking in ~/.copilot-sessions with per-directory filtering.
# Format: session_id|name|timestamp|cwd

COPILOT_S_VERSION="2.0.0"

SESSIONS_FILE="$HOME/.copilot-sessions"
SESSION_STATE_DIR="$HOME/.copilot/session-state"
SHOW_ALL=false
FILTERED_FILE=""

COPILOT_OTEL_DIR="$HOME/.copilot/otel"

# --- Per-launch run id (session reports) ---
# A random RFC 4122 v4 UUID from /dev/urandom (no python/uuidgen needed;
# bash 3.2 compatible). Empty if no randomness is available, in which case
# no session report is recorded for this launch.
COPILOT_S_RUN_ID=""
gen_run_id() {
  local hex
  hex=$(od -An -N16 -tx1 /dev/urandom 2>/dev/null | tr -d ' \n') || return 1
  [[ "$hex" =~ ^[0-9a-f]{32}$ ]] || return 1
  local variant
  variant=$(printf '%x' $(( (16#${hex:16:1} & 3) | 8 )))
  echo "${hex:0:8}-${hex:8:4}-4${hex:13:3}-${variant}${hex:17:3}-${hex:20:12}"
}

# Set up OTEL export (creates $COPILOT_OTEL_DIR and exports env vars used by
# `copilot` for telemetry). Deliberately NOT called at script load time: it
# has filesystem side effects (mkdir), so it must only run once we know
# we're past --help/--version handling and are actually about to do
# session-manager work (list sessions, launch `copilot`, etc). This keeps
# `copilot-s --help`/`--version` side-effect-free.
# The file name keeps the copilot-otel-*.jsonl pattern every reader globs,
# plus this launch's run id, so two launches started in the same second
# never share (or race on) one OTEL file and a session report can read its
# own launch's file exactly, without guessing from timestamps.
setup_otel() {
  mkdir -p "$COPILOT_OTEL_DIR"
  export COPILOT_OTEL_ENABLED=true
  export COPILOT_OTEL_EXPORTER_TYPE=file
  COPILOT_OTEL_RUN_TS="$(date +%Y%m%d-%H%M%S)"
  COPILOT_S_RUN_ID="$(gen_run_id)" || COPILOT_S_RUN_ID=""
  if [[ -n "$COPILOT_S_RUN_ID" ]]; then
    export COPILOT_OTEL_FILE_EXPORTER_PATH="$COPILOT_OTEL_DIR/copilot-otel-$COPILOT_OTEL_RUN_TS-$COPILOT_S_RUN_ID.jsonl"
  else
    export COPILOT_OTEL_FILE_EXPORTER_PATH="$COPILOT_OTEL_DIR/copilot-otel-$COPILOT_OTEL_RUN_TS.jsonl"
  fi
}

# --- Locate this script's own real (symlink-resolved) directory ---
# Works whether copilot-s is invoked as a symlink (default `install.sh`
# mode, pointing back into the repo checkout) or as a plain copy
# (`install.sh --copy`), and regardless of --prefix, because the task
# report helper is always installed as a sibling file right next to this
# script by scripts/install.sh.
resolve_script_dir() {
  local src="${BASH_SOURCE[0]}"
  local dir
  while [[ -L "$src" ]]; do
    dir="$(cd -P "$(dirname "$src")" && pwd)"
    src="$(readlink "$src")"
    [[ "$src" != /* ]] && src="$dir/$src"
  done
  (cd -P "$(dirname "$src")" && pwd)
}
SCRIPT_DIR="$(resolve_script_dir)"

# --- Task usage reporting ---
# Resolution order:
#   1. COPILOT_TASK_REPORT_HELPER env override (explicit escape hatch).
#   2. Sibling copilot-task-report.py next to this script's real location
#      (correct for both symlink and --copy installs, any --prefix).
#   3. Fallback to the conventional ~/.local/bin path, in case this script
#      is being run directly from a checkout without a helper alongside it.
if [[ -n "${COPILOT_TASK_REPORT_HELPER:-}" ]]; then
  TASK_REPORT_HELPER="$COPILOT_TASK_REPORT_HELPER"
elif [[ -f "$SCRIPT_DIR/copilot-task-report.py" ]]; then
  TASK_REPORT_HELPER="$SCRIPT_DIR/copilot-task-report.py"
else
  TASK_REPORT_HELPER="$HOME/.local/bin/copilot-task-report.py"
fi
# --- Empty-session cleanup helper (menu option c) ---
# Same resolution order as the task report helper above.
if [[ -n "${COPILOT_SESSION_CLEANUP_HELPER:-}" ]]; then
  SESSION_CLEANUP_HELPER="$COPILOT_SESSION_CLEANUP_HELPER"
elif [[ -f "$SCRIPT_DIR/copilot-session-cleanup.py" ]]; then
  SESSION_CLEANUP_HELPER="$SCRIPT_DIR/copilot-session-cleanup.py"
else
  SESSION_CLEANUP_HELPER="$HOME/.local/bin/copilot-session-cleanup.py"
fi
SESSION_QUARANTINE_DIR="$HOME/.copilot-s-quarantine"
# --- Run-report cleanup helper (menu option r) ---
# Same resolution order as the task report helper above.
if [[ -n "${COPILOT_REPORT_CLEANUP_HELPER:-}" ]]; then
  REPORT_CLEANUP_HELPER="$COPILOT_REPORT_CLEANUP_HELPER"
elif [[ -f "$SCRIPT_DIR/copilot-report-cleanup.py" ]]; then
  REPORT_CLEANUP_HELPER="$SCRIPT_DIR/copilot-report-cleanup.py"
else
  REPORT_CLEANUP_HELPER="$HOME/.local/bin/copilot-report-cleanup.py"
fi
# --- Per-launch session report helper ---
# Same resolution order as the task report helper above.
if [[ -n "${COPILOT_SESSION_REPORT_HELPER:-}" ]]; then
  SESSION_REPORT_HELPER="$COPILOT_SESSION_REPORT_HELPER"
elif [[ -f "$SCRIPT_DIR/copilot-session-report.py" ]]; then
  SESSION_REPORT_HELPER="$SCRIPT_DIR/copilot-session-report.py"
else
  SESSION_REPORT_HELPER="$HOME/.local/bin/copilot-session-report.py"
fi
# --- Session-local RTK hook plugin (`--rtk` only) ---
# Loaded for one launch via `copilot --plugin-dir`, never installed as a
# Copilot plugin. Lives next to this script's real location (repo checkout
# for symlink installs, the install prefix for --copy installs).
if [[ -n "${COPILOT_S_RTK_PLUGIN_DIR:-}" ]]; then
  RTK_PLUGIN_DIR="$COPILOT_S_RTK_PLUGIN_DIR"
else
  RTK_PLUGIN_DIR="$SCRIPT_DIR/copilot-s-rtk-plugin"
fi
# Launch mode: set only by --rtk on THIS invocation; never persisted.
RTK_MODE=false
# Display only — copilot-session-report.py enforces the exact RTK version.
SUPPORTED_RTK_LABEL="1.2.0"
# Per-launch report state (filled by start_run_report / run_copilot).
RUN_REPORT_PENDING=false
RUN_REPORT_DIR=""
RUN_USAGE_FILE=""
RTK_RUN_BIN=""
RTK_ENV_KEYS=()
RTK_ENV_VALS=()
REPORT_EXIT_CODE=""
REPORT_SESSION_ID=""
REPORT_LAUNCHED_EPOCH=""
REPORT_ENDED_EPOCH=""
# RTK mode: PID of this launch's own background RTK publisher (empty when
# none is running). Started right before `copilot`, stopped and reaped right
# after it (always before the run is finalized).
RTK_PUBLISHER_PID=""
# RTK mode: caller-supplied extra plugin directories (raw operands, in
# order) and whether Copilot may resolve relative ones against a session
# directory other than $PWD (-C, --worktree, or any resume/session selector).
CALLER_PLUGIN_DIRS=()
CALLER_SESSION_CWD_UNCERTAIN=false
# Directories the launched session may run in (project hook configurations
# there are checked: RTK mode refuses, normal mode notes contamination), and
# why it cannot be determined, if so (RTK mode then refuses to launch).
SESSION_PROJECT_DIRS=()
SESSION_PROJECT_UNKNOWN=""

# Recorded working directory of an existing session (its workspace.yaml
# `cwd:`), printed only if it is an absolute path; nothing otherwise.
session_recorded_cwd() {
  local sid="${1:-}" cwd=""
  [[ "$sid" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]] || return 0
  [[ -f "$SESSION_STATE_DIR/$sid/workspace.yaml" ]] || return 0
  cwd=$(grep -m 1 '^cwd:' "$SESSION_STATE_DIR/$sid/workspace.yaml" 2>/dev/null | sed 's/^cwd: *//') || true
  if [[ "$cwd" == /* ]]; then
    echo "$cwd"
  fi
  return 0
}

# A session the caller resumes by id: Copilot switches to its recorded
# directory, which must be known.
note_resumed_session_dir() {
  local dir
  dir=$(session_recorded_cwd "${1:-}")
  if [[ -n "$dir" ]]; then
    SESSION_PROJECT_DIRS+=("$dir")
  else
    SESSION_PROJECT_UNKNOWN="resumed session ${1:-?} has no recorded directory copilot-s can read"
  fi
  return 0
}

# --session-id: an EXISTING session (its state directory exists in any
# form) resumes in its recorded directory, which must then be readable and
# absolute — otherwise the session directory is unknown (RTK mode refuses,
# normal mode notes it). Only an id whose state directory is truly absent
# starts a new session in the launch directory (already listed). An id that
# is not a safe identifier cannot be checked and is unknown too.
note_selected_session_dir() {
  local sid="${1:-}" dir
  if [[ ! "$sid" =~ ^[A-Za-z0-9][A-Za-z0-9._-]*$ ]]; then
    SESSION_PROJECT_UNKNOWN="--session-id ${sid:-?} is not a session id copilot-s can check"
    return 0
  fi
  if [[ ! -e "$SESSION_STATE_DIR/$sid" && ! -L "$SESSION_STATE_DIR/$sid" ]]; then
    return 0
  fi
  dir=$(session_recorded_cwd "$sid")
  if [[ -n "$dir" ]]; then
    SESSION_PROJECT_DIRS+=("$dir")
  else
    SESSION_PROJECT_UNKNOWN="existing session $sid (--session-id) has no recorded directory copilot-s can read"
  fi
  return 0
}
# --- Subagent model refresh helper (menu option p) ---
# Same resolution order as the task report helper above.
if [[ -n "${COPILOT_MODEL_REFRESH_HELPER:-}" ]]; then
  MODEL_REFRESH_HELPER="$COPILOT_MODEL_REFRESH_HELPER"
elif [[ -f "$SCRIPT_DIR/copilot-model-refresh.py" ]]; then
  MODEL_REFRESH_HELPER="$SCRIPT_DIR/copilot-model-refresh.py"
else
  MODEL_REFRESH_HELPER="$HOME/.local/bin/copilot-model-refresh.py"
fi

# --- Short cross-process lock for ~/.copilot-sessions rewrites ---
# Exclusive flock(2) on "$SESSIONS_FILE.lock" (a persistent regular file),
# shared with copilot-session-cleanup.py. Held only around one
# read-modify-write of the index — never across prompts or while `copilot`
# runs. The lock belongs to fd 9 of this shell: a short python3 child takes
# it on the inherited descriptor, so it stays held until registry_unlock
# closes fd 9, and the kernel releases it automatically if this script dies
# (no stale-lock stealing, no removal of anyone else's lock). If the lock
# cannot be acquired, registry_lock returns 1 and callers must NOT modify
# the index.
REGISTRY_LOCK_FILE="$SESSIONS_FILE.lock"
REGISTRY_LOCK_HELD=false
REGISTRY_FLOCK_PY='
import fcntl, os, stat, sys, time
st = os.fstat(9)
if not stat.S_ISREG(st.st_mode) or st.st_uid != os.getuid():
    sys.exit(3)
deadline = time.monotonic() + 10
while True:
    try:
        fcntl.flock(9, fcntl.LOCK_EX | fcntl.LOCK_NB)
        sys.exit(0)
    except BlockingIOError:
        pass
    except OSError:
        sys.exit(2)
    if time.monotonic() >= deadline:
        sys.exit(1)
    time.sleep(0.05)
'

registry_lock() {
  if [[ "$REGISTRY_LOCK_HELD" == "true" ]]; then
    return 0
  fi
  if [[ -L "$REGISTRY_LOCK_FILE" ]] || { [[ -e "$REGISTRY_LOCK_FILE" ]] && [[ ! -f "$REGISTRY_LOCK_FILE" ]]; }; then
    echo -e "${YELLOW}Warning: session-list lock $REGISTRY_LOCK_FILE is not a regular file — session list left unchanged.${RESET}" >&2
    return 1
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo -e "${YELLOW}Warning: python3 not found — cannot lock the session list; left unchanged.${RESET}" >&2
    return 1
  fi
  if ! { exec 9>>"$REGISTRY_LOCK_FILE"; } 2>/dev/null; then
    echo -e "${YELLOW}Warning: cannot open session-list lock $REGISTRY_LOCK_FILE — session list left unchanged.${RESET}" >&2
    return 1
  fi
  if python3 -c "$REGISTRY_FLOCK_PY" 2>/dev/null; then
    REGISTRY_LOCK_HELD=true
    return 0
  fi
  exec 9>&-
  echo -e "${YELLOW}Warning: session list is busy (another copilot-s or cleanup holds $REGISTRY_LOCK_FILE) — left unchanged.${RESET}" >&2
  return 1
}

registry_unlock() {
  if [[ "$REGISTRY_LOCK_HELD" == "true" ]]; then
    exec 9>&-
    REGISTRY_LOCK_HELD=false
  fi
  return 0
}

TASK_KEY_REGEX='[A-Z][A-Z0-9]+-[0-9]+'
# Must match MAX_TASK_ID_LEN in copilot-task-report.py's normalize_task_id
# (defense-in-depth: this bash-side fast path is a convenience/no-python
# shortcut, not the source of truth, but should never accept something the
# Python side would reject on length grounds alone).
MAX_TASK_ID_LEN=200
# Reports directory can be overridden with COPILOT_TASK_REPORTS_DIR; this is
# only used for the informational message below (the Python helper is the
# actual source of truth for where reports are written).
TASK_REPORTS_DIR_DISPLAY="${COPILOT_TASK_REPORTS_DIR:-$HOME/Desktop/CopilotTaskReports}"

# --- Per-session context metrics (future copilot-s sessions only) ---
# Must match CONTEXT_SIDECAR_NAME in copilot-task-report.py. Only sessions
# that copilot-s itself created (and identified unambiguously after the run)
# ever get this file; legacy/imported/external sessions never do, and the
# session list only ever reads existing sidecars (never events logs).
CONTEXT_SIDECAR_NAME="copilot-s-context.json"
# Parallel to the lines of $FILTERED_FILE (index = line number - 1); filled
# by load_context_labels. Plain indexed array: bash 3.2 compatible.
CONTEXT_LABELS=()

BOLD='\033[1m'
DIM='\033[2m'
CYAN='\033[36m'
GREEN='\033[32m'
YELLOW='\033[33m'
RED='\033[31m'
RESET='\033[0m'

cleanup() {
  if [[ -n "${RTK_PUBLISHER_PID:-}" ]]; then
    stop_rtk_publisher
  fi
  registry_unlock
  if [[ -n "${FILTERED_FILE:-}" ]] && [[ -f "$FILTERED_FILE" ]]; then
    rm -f "$FILTERED_FILE"
  fi
}
trap cleanup EXIT

# Replace $HOME with ~ for display
short_path() {
  echo "${1/#$HOME/\~}"
}

# Format an ISO-ish "YYYY-MM-DDTHH:MM:SS[.fff]" timestamp for display.
# Supports both BSD date (macOS, `date -j -f`) and GNU date (Linux, `date -d`).
# Falls back to a raw substring if neither parses successfully.
format_timestamp() {
  local raw="${1:-}"
  local trimmed="${raw%%.*}"
  [[ -z "$trimmed" ]] && return 0
  local out=""
  if out=$(date -j -f "%Y-%m-%dT%H:%M:%S" "$trimmed" "+%Y-%m-%d %H:%M" 2>/dev/null); then
    echo "$out"
    return 0
  fi
  if out=$(date -d "$trimmed" "+%Y-%m-%d %H:%M" 2>/dev/null); then
    echo "$out"
    return 0
  fi
  echo "${raw:0:16}"
}

# Read a line from the terminal, safe against EOF and leftover stdin
prompt_read() {
  local varname="$1"
  # Use Bash's builtin read for a single line from the controlling terminal.
  # The caller's variable is the intentional dynamic read target.
  # shellcheck disable=SC2229
  IFS= read -r "$varname" < /dev/tty 2>/dev/null || true
}

# Drain any leftover bytes in /dev/tty after copilot exits
flush_stdin() {
  local dummy=""
  # shellcheck disable=SC2034  # value is intentionally discarded
  while IFS= read -r -t 0.2 dummy < /dev/tty 2>/dev/null; do true; done
  return 0
}

# --- Task ID resolution (for usage reporting) ---
# Extract a conservative KEY-123-style task ID (e.g. ABC-123) from a branch name, if present.
# Branch names can contain lowercase segments (e.g. "feature/abc-123-foo"),
# so normalize to uppercase before matching/returning.
extract_task_key_from_branch() {
  local branch="${1:-}"
  [[ -z "$branch" ]] && return 1
  local upper
  upper=$(echo "$branch" | tr '[:lower:]' '[:upper:]')
  if [[ "$upper" =~ $TASK_KEY_REGEX ]]; then
    echo "${BASH_REMATCH[0]}"
    return 0
  fi
  return 1
}

# Validate/normalize a task ID or free-form task name for the manual-entry
# prompt below. Conservative KEY-123-style IDs are validated locally (fast
# path, no python needed); anything else is delegated to
# `copilot-task-report.py normalize-task-id`, which is the single source of
# truth for the generic sanitization/collision-safety rules (trim/collapse,
# safe charset, max length, traversal/control-char rejection, case-folding).
# Prints the normalized ID and returns 0 on success; returns 1 (no output)
# if invalid.
normalize_and_validate_task() {
  local raw="${1:-}"
  [[ -z "$raw" ]] && return 1
  local upper
  # xargs is used here purely to trim surrounding whitespace on the fast
  # path; malformed input (e.g. an unbalanced quote) makes it print its
  # own "unterminated quote"-style diagnostic to stderr, which is never
  # an intended validation message for the caller and must not leak —
  # any such input simply fails the regex check below and falls through
  # to the python normalizer, exactly like any other non-KEY-123 input.
  upper=$(echo "$raw" | tr '[:lower:]' '[:upper:]' | xargs 2>/dev/null)
  if [[ ${#upper} -le $MAX_TASK_ID_LEN && "$upper" =~ ^${TASK_KEY_REGEX}$ ]]; then
    echo "$upper"
    return 0
  fi
  if [[ -f "$TASK_REPORT_HELPER" ]] && command -v python3 >/dev/null 2>&1; then
    python3 "$TASK_REPORT_HELPER" normalize-task-id -- "$raw" 2>/dev/null
    return $?
  fi
  return 1
}

current_git_branch() {
  git rev-parse --abbrev-ref HEAD 2>/dev/null || true
}

# Read the branch recorded for an existing (possibly resumed) session.
session_stored_branch() {
  local session_dir="$1"
  [[ -f "$session_dir/workspace.yaml" ]] || return 1
  grep '^branch:' "$session_dir/workspace.yaml" 2>/dev/null | sed 's/^branch: *//'
}

# Determine the task ID to attribute usage to for this invocation.
#   $1 = session_id (empty if this is about to be a brand-new session)
# Prints the resolved key (or empty string to let the report helper reuse
# whatever it last knew for this session / fall back to UNASSIGNED).
resolve_task_id() {
  local session_id="${1:-}"
  local task_id="" branch=""

  branch=$(current_git_branch)
  task_id=$(extract_task_key_from_branch "$branch") || true

  if [[ -z "$task_id" && -n "$session_id" ]]; then
    branch=$(session_stored_branch "$SESSION_STATE_DIR/$session_id") || true
    task_id=$(extract_task_key_from_branch "$branch") || true
  fi

  if [[ -z "$task_id" && -z "$session_id" ]]; then
    # Brand-new session with no detectable Task key: ask (re-prompting on
    # invalid input rather than silently accepting/mangling it).
    local attempts=0 input="" normalized=""
    while [[ $attempts -lt 3 ]]; do
      echo -ne "${YELLOW}No task ID detected on this branch. Task ID/name for usage tracking (Enter to skip): ${RESET}" >&2
      prompt_read input
      if [[ -z "$input" ]]; then
        task_id="UNASSIGNED"
        break
      fi
      if normalized=$(normalize_and_validate_task "$input"); then
        task_id="$normalized"
        break
      fi
      echo -e "${RED}Invalid task ID/name '${input}'. Expected e.g. ABC-123, or a free-form name (letters/digits/./_/-).${RESET}" >&2
      attempts=$((attempts + 1))
    done
    if [[ -z "$task_id" ]]; then
      echo -e "${YELLOW}Too many invalid attempts; defaulting to UNASSIGNED.${RESET}" >&2
      task_id="UNASSIGNED"
    fi
  fi

  echo "$task_id"
}

# Non-interactive task ID resolution for batch contexts (multi-select
# delete): never prompts. Falls back to whatever the task report helper
# already has on file for this session (via the python state), or
# UNASSIGNED if nothing is known — the helper itself preserves any
# previously-resolved task ID when passed an empty --task.
resolve_task_id_noninteractive() {
  local session_id="${1:-}"
  local branch=""
  branch=$(session_stored_branch "$SESSION_STATE_DIR/$session_id") || true
  extract_task_key_from_branch "$branch" || true
}

# Ingest this run's usage into the per-task report. Never fails hard:
# any error is downgraded to a warning so keep/rename/delete flows always run.
update_task_report() {
  local session_id="${1:-}" task_id="${2:-}"
  [[ -z "$session_id" ]] && return 0
  if [[ ! -f "$TASK_REPORT_HELPER" ]]; then
    echo -e "${YELLOW}Warning: task report helper not found at $TASK_REPORT_HELPER — usage reporting skipped for this session. Set COPILOT_TASK_REPORT_HELPER or re-run the installer.${RESET}" >&2
    return 0
  fi
  command -v python3 >/dev/null 2>&1 || { echo -e "${YELLOW}Warning: python3 not found — task usage reporting skipped.${RESET}" >&2; return 0; }

  local session_dir="$SESSION_STATE_DIR/$session_id"
  local rc=0 out
  out=$(python3 "$TASK_REPORT_HELPER" ingest \
      --session-id "$session_id" \
      --task="$task_id" \
      --session-dir "$session_dir" 2>&1) || rc=$?
  if [[ $rc -ne 0 ]]; then
    echo -e "${YELLOW}Warning: task usage report update failed (session kept/renamed/deleted normally):${RESET} ${out}" >&2
  elif [[ -n "$out" ]]; then
    # The helper succeeded (exit 0) but still printed something to
    # stderr — e.g. a legacy-migration conflict/failure warning. That
    # must never be silently swallowed just because the ingest itself
    # succeeded; only skip printing anything when there's truly nothing
    # to say, so the normal/clean-run path stays quiet.
    echo -e "${YELLOW}${out}${RESET}" >&2
  fi
  return 0
}

# --- Per-launch session reports (normal and --rtk launches) ---
# start_run_report MODE-INDEPENDENT ARGS:
#   $1 = resumed session id (empty for a new session)
#   $2 = "true" if the caller's own options select a session
#   $3 = "true" if the caller passed its own --usage-output-file
# Normal mode: any failure is a warning and the launch continues without a
# report. RTK mode: any failure (or a preflight refusal) stops BEFORE
# `copilot` is launched — RTK mode never silently falls back to normal.
start_run_report() {
  local session_id="${1:-}" caller_selects="${2:-false}" caller_usage="${3:-false}"
  local mode="normal"
  [[ "$RTK_MODE" == "true" ]] && mode="rtk"
  RUN_REPORT_PENDING=false
  RUN_REPORT_DIR=""
  RUN_USAGE_FILE=""
  RTK_RUN_BIN=""
  RTK_ENV_KEYS=()
  RTK_ENV_VALS=()

  local problem=""
  if [[ -z "$COPILOT_S_RUN_ID" ]]; then
    problem="no run id could be generated (no /dev/urandom)"
  elif [[ ! -f "$SESSION_REPORT_HELPER" ]]; then
    problem="session report helper not found at $SESSION_REPORT_HELPER (set COPILOT_SESSION_REPORT_HELPER or re-run the installer)"
  elif ! command -v python3 >/dev/null 2>&1; then
    problem="python3 not found"
  fi
  if [[ -n "$problem" ]]; then
    if [[ "$mode" == "rtk" ]]; then
      echo -e "${RED}RTK mode not started: ${problem}. Nothing was launched.${RESET}" >&2
      exit 1
    fi
    echo -e "${YELLOW}Warning: ${problem} — no session report for this launch.${RESET}" >&2
    return 0
  fi

  local -a args=(start --run-id "$COPILOT_S_RUN_ID" --mode "$mode" --cwd "$PWD" --copilot-s-version "$COPILOT_S_VERSION")
  if [[ -n "$session_id" ]]; then
    args+=(--launch-kind resume --resume-session-id "$session_id")
  else
    args+=(--launch-kind new)
  fi
  [[ "$caller_selects" == "true" ]] && args+=(--caller-selects-session)
  if [[ "$caller_usage" == "true" ]]; then
    args+=(--usage-file-owner caller)
  else
    args+=(--usage-file-owner owned)
  fi
  [[ -n "${COPILOT_OTEL_FILE_EXPORTER_PATH:-}" ]] && args+=(--otel-file "$COPILOT_OTEL_FILE_EXPORTER_PATH")
  local project_dir
  for project_dir in "${SESSION_PROJECT_DIRS[@]+"${SESSION_PROJECT_DIRS[@]}"}"; do
    args+=("--project-dir=$project_dir")
  done
  if [[ -n "$SESSION_PROJECT_UNKNOWN" ]]; then
    args+=("--project-dir-unknown=$SESSION_PROJECT_UNKNOWN")
  fi
  if [[ "$mode" == "rtk" ]]; then
    args+=(--plugin-dir "$RTK_PLUGIN_DIR")
    local extra_dir
    for extra_dir in "${CALLER_PLUGIN_DIRS[@]+"${CALLER_PLUGIN_DIRS[@]}"}"; do
      args+=("--extra-plugin-dir=$extra_dir")
    done
    if [[ "$CALLER_SESSION_CWD_UNCERTAIN" == "true" ]]; then
      args+=(--session-cwd-uncertain)
    fi
  fi

  local out="" rc=0
  out=$(python3 "$SESSION_REPORT_HELPER" "${args[@]}") || rc=$?
  if [[ $rc -ne 0 ]]; then
    if [[ "$mode" == "rtk" ]]; then
      if [[ $rc -eq 3 ]]; then
        echo -e "${RED}RTK mode refused (see above). Nothing was launched.${RESET}" >&2
      else
        echo -e "${RED}RTK mode not started: the session report helper failed (exit $rc). Nothing was launched.${RESET}" >&2
      fi
      exit 1
    fi
    echo -e "${YELLOW}Warning: session report not started (exit $rc) — launching without a report.${RESET}" >&2
    return 0
  fi

  local key value tab=$'\t'
  while IFS="$tab" read -r key value; do
    case "$key" in
      RUN_DIR) RUN_REPORT_DIR="$value" ;;
      USAGE_FILE) RUN_USAGE_FILE="$value" ;;
      RTK_BIN) RTK_RUN_BIN="$value" ;;
      RTK_DB_PATH|RTK_TEE_DIR|RTK_RECALL_DB|RTK_CONFIG_DIR|RTK_TELEMETRY_DISABLED)
        RTK_ENV_KEYS+=("$key")
        RTK_ENV_VALS+=("$value")
        ;;
    esac
  done <<< "$out"

  if [[ -z "$RUN_REPORT_DIR" ]]; then
    if [[ "$mode" == "rtk" ]]; then
      echo -e "${RED}RTK mode not started: the session report helper returned no run folder. Nothing was launched.${RESET}" >&2
      exit 1
    fi
    echo -e "${YELLOW}Warning: session report helper returned no run folder — launching without a report.${RESET}" >&2
    return 0
  fi
  if [[ "$mode" == "rtk" && ( -z "$RTK_RUN_BIN" || ${#RTK_ENV_KEYS[@]} -ne 5 ) ]]; then
    echo -e "${RED}RTK mode not started: incomplete RTK isolation settings from the helper. Nothing was launched.${RESET}" >&2
    exit 1
  fi
  RUN_REPORT_PENDING=true
  return 0
}

# RTK mode only: drop every inherited RTK_* variable (names only — values
# are never printed) and export this launch's isolated RTK paths plus the
# pinned binary and run folder the session-local hook reads. HOME and all
# other variables are left untouched. No eval: names come from a fixed case.
apply_rtk_env() {
  local name i=0
  for name in $(compgen -e); do
    case "$name" in
      RTK_*) unset "$name" ;;
    esac
  done
  while [[ $i -lt ${#RTK_ENV_KEYS[@]} ]]; do
    case "${RTK_ENV_KEYS[$i]}" in
      RTK_DB_PATH|RTK_TEE_DIR|RTK_RECALL_DB|RTK_CONFIG_DIR|RTK_TELEMETRY_DISABLED)
        export "${RTK_ENV_KEYS[$i]}=${RTK_ENV_VALS[$i]}"
        ;;
    esac
    i=$((i + 1))
  done
  export COPILOT_S_RUN_DIR="$RUN_REPORT_DIR"
  export COPILOT_S_RTK_BIN="$RTK_RUN_BIN"
}

# RTK mode only, after a successful start/preflight: start this launch's own
# RTK publisher in the background (one per launch, never a daemon). It
# republishes ~/.copilot/copilot-s-rtk-export/v1/runs/<run-id>.json about
# every 30 s with one bounded `rtk gain` at a time on the launch's private
# database, leads its own process group, ignores SIGINT, and exits on
# SIGTERM/SIGHUP, once the run is finalized, or as soon as its parent is no
# longer this shell ($$ — run_copilot is never called from a subshell).
# No output reaches the terminal. Failing to start it never affects the
# launch.
start_rtk_publisher() {
  RTK_PUBLISHER_PID=""
  [[ "$RTK_MODE" == "true" && "$RUN_REPORT_PENDING" == "true" && -n "$COPILOT_S_RUN_ID" ]] || return 0
  python3 "$SESSION_REPORT_HELPER" rtk-publisher --run-id "$COPILOT_S_RUN_ID" --parent-pid "$$" \
    </dev/null >/dev/null 2>&1 &
  RTK_PUBLISHER_PID=$!
  return 0
}

# Stop and REAP this launch's RTK publisher (no-op if none): SIGTERM to its
# process group (it and any running `rtk gain` child) and to the PID itself,
# up to 5 s for it to exit, then SIGKILL to the group and PID, then `wait`.
# Called right after `copilot` returns and again (no-op) before the run is
# finalized and on exit, so a late active result can never be published
# after the final figures.
stop_rtk_publisher() {
  local pid="${RTK_PUBLISHER_PID:-}"
  [[ -n "$pid" ]] || return 0
  RTK_PUBLISHER_PID=""
  kill -TERM -- "-$pid" 2>/dev/null || true
  kill -TERM "$pid" 2>/dev/null || true
  local tries=0
  while kill -0 "$pid" 2>/dev/null && [[ $tries -lt 50 ]]; do
    sleep 0.1
    tries=$((tries + 1))
  done
  if kill -0 "$pid" 2>/dev/null; then
    kill -KILL -- "-$pid" 2>/dev/null || true
    kill -KILL "$pid" 2>/dev/null || true
  fi
  wait "$pid" 2>/dev/null || true
  return 0
}

# Finalize this launch's run record exactly once (state, exact session link,
# OTEL usage, frozen estimated cost, RTK aggregates). Called right after the
# task ingest (so the official pricing cache is as fresh as the ingest left
# it, and before a possible session delete), and again as a no-op safety net
# after the stop flow. Never fatal.
finalize_run_report() {
  # The launch's publisher must be gone (stopped and reaped) before the
  # final figures are written and published.
  stop_rtk_publisher
  [[ "$RUN_REPORT_PENDING" == "true" ]] || return 0
  RUN_REPORT_PENDING=false
  local -a args=(finish --run-id "$COPILOT_S_RUN_ID" --exit-code "${REPORT_EXIT_CODE:-1}" --session-state-dir "$SESSION_STATE_DIR")
  [[ -n "$REPORT_LAUNCHED_EPOCH" ]] && args+=(--launched-epoch "$REPORT_LAUNCHED_EPOCH")
  [[ -n "$REPORT_ENDED_EPOCH" ]] && args+=(--ended-epoch "$REPORT_ENDED_EPOCH")
  [[ -n "$REPORT_SESSION_ID" ]] && args+=(--session-id "$REPORT_SESSION_ID")
  local out="" rc=0 line
  out=$(python3 "$SESSION_REPORT_HELPER" "${args[@]}" 2>&1) || rc=$?
  if [[ -n "$out" ]]; then
    while IFS= read -r line; do
      [[ -n "$line" ]] && echo -e "  ${DIM}${line}${RESET}"
    done <<< "$out"
  fi
  if [[ $rc -ne 0 ]]; then
    echo -e "${YELLOW}Warning: session report finalization had problems (exit $rc); the session itself is unaffected.${RESET}" >&2
  fi
  return 0
}

# Read-only: print the session report for one session id and exit.
show_session_report() {
  local sid="${1:-}"
  if [[ -z "$sid" ]]; then
    echo -e "${RED}Usage:${RESET} copilot-s --session-report SESSION_ID" >&2
    return 1
  fi
  if [[ ! -f "$SESSION_REPORT_HELPER" ]]; then
    echo -e "${RED}session report helper not found:${RESET} $SESSION_REPORT_HELPER" >&2
    return 1
  fi
  command -v python3 >/dev/null 2>&1 || { echo -e "${RED}python3 not found.${RESET}" >&2; return 1; }
  python3 "$SESSION_REPORT_HELPER" session --session-id "$sid"
}

# --- Session name resolution ---
# Priority: saved name > workspace.yaml name/summary > first user message > dir name
get_session_name() {
  local session_dir="$1"
  local yaml="$session_dir/workspace.yaml"
  local events="$session_dir/events.jsonl"

  # Try workspace.yaml fields
  if [[ -f "$yaml" ]]; then
    local name summary
    name=$(grep '^name:' "$yaml" 2>/dev/null | sed 's/^name: *//' || true)
    summary=$(grep '^summary:' "$yaml" 2>/dev/null | sed 's/^summary: *//' || true)

    if [[ -n "$name" && "$name" != "exit" && "$name" != "q" ]]; then
      echo "$name"; return
    fi
    if [[ -n "$summary" && "$summary" != "exit" && "$summary" != "q" ]]; then
      echo "$summary"; return
    fi
  fi

  # Try first user message from events
  if [[ -f "$events" ]]; then
    local first_msg
    # Pass the events path as argv[1] rather than interpolating it into the
    # Python source string, so paths containing quotes/backslashes/etc.
    # can never break out of the string literal or inject code.
    first_msg=$(python3 -c "
import json, sys
with open(sys.argv[1]) as f:
    for line in f:
        try:
            e = json.loads(line)
            if e.get('type') == 'user.message':
                msg = e.get('data', {}).get('content', '').strip()
                if msg and msg.lower() not in ('exit', 'quit', 'q', '/exit', '/quit'):
                    msg = msg.split(chr(10))[0][:50]
                    if len(msg) == 50:
                        msg = msg[:47] + '...'
                    print(msg)
                    break
        except Exception:
            pass
" "$events" 2>/dev/null || true)
    if [[ -n "$first_msg" ]]; then
      echo "$first_msg"; return
    fi
  fi

  # Fallback: directory name
  if [[ -f "$yaml" ]]; then
    local cwd
    cwd=$(grep '^cwd:' "$yaml" 2>/dev/null | sed 's/^cwd: *//' || true)
    if [[ -n "$cwd" ]]; then
      echo "$(basename "$cwd") session"; return
    fi
  fi

  echo "unnamed"
}

# --- Save / update a session entry ---
# Returns non-zero if the index was not updated (session-list lock busy/
# unavailable — warning already shown — or a temp-file write/rename failed);
# in every such case the index file itself was not replaced. Callers must
# check it with `if`, so a failed save never aborts the launcher under
# `set -e` or reports success.
save_session() {
  registry_lock || return 1
  local rc=0
  save_session_unlocked "$@" || rc=$?
  registry_unlock
  return $rc
}

save_session_unlocked() {
  local session_id="$1" name="$2" timestamp="$3" cwd="$4"
  local force="${5:-false}"
  # Names occupy one pipe-delimited field. Keep the serialized value safe and
  # use the same normalized value for subsequent display/listing.
  name="${name//|/ }"
  name="${name#"${name%%[![:space:]]*}"}"
  name="${name%"${name##*[![:space:]]}"}"

  # Every step that affects the index is checked explicitly (this runs
  # under `if`, where errexit is off). The index is only ever replaced by a
  # single same-directory rename of a fully written temp file we created, so
  # any failure (non-zero return) leaves the original index unchanged; once
  # that rename succeeds the function returns 0. On failure only our own
  # temp file is removed.
  local tmp="" write_ok=true

  # Update existing entry
  if [[ -f "$SESSIONS_FILE" ]] && grep -q "^${session_id}|" "$SESSIONS_FILE" 2>/dev/null; then
    local existing_name
    existing_name=$(grep -m 1 "^${session_id}|" "$SESSIONS_FILE" | cut -d'|' -f2) || return 1
    local should_update=false
    if [[ "$force" == "true" ]]; then
      should_update=true
    elif [[ "$existing_name" == "unnamed" || -z "$existing_name" ]] && [[ "$name" != "unnamed" && -n "$name" ]]; then
      should_update=true
    fi
    if [[ "$should_update" == "true" ]]; then
      tmp=$(mktemp "$SESSIONS_FILE.XXXXXX") || return 1
      [[ -n "$tmp" ]] || return 1
      if ! while IFS='|' read -r eid ename ets ecwd; do
        [[ -z "$eid" ]] && continue
        if [[ "$eid" == "$session_id" ]]; then
          echo "${session_id}|${name}|${timestamp}|${cwd}" || write_ok=false
        else
          echo "${eid}|${ename}|${ets}|${ecwd}" || write_ok=false
        fi
      done < "$SESSIONS_FILE" > "$tmp"; then
        write_ok=false
      fi
      if [[ "$write_ok" != "true" ]] || ! mv -f "$tmp" "$SESSIONS_FILE"; then
        rm -f "$tmp"
        return 1
      fi
    fi
    return 0
  fi

  # New entry: copy the current index plus the new row into our temp file,
  # then rename it into place (same transaction rules as above).
  tmp=$(mktemp "$SESSIONS_FILE.XXXXXX") || return 1
  [[ -n "$tmp" ]] || return 1
  if [[ -f "$SESSIONS_FILE" ]] && ! cat "$SESSIONS_FILE" > "$tmp"; then
    write_ok=false
  fi
  if [[ "$write_ok" != "true" ]] || ! echo "${session_id}|${name}|${timestamp}|${cwd}" >> "$tmp" \
      || ! mv -f "$tmp" "$SESSIONS_FILE"; then
    rm -f "$tmp"
    return 1
  fi
  return 0
}

# --- Refresh stale names in the sessions file ---
refresh_session_names() {
  [[ -f "$SESSIONS_FILE" ]] || return 0
  local tmp
  tmp=$(mktemp)
  while IFS='|' read -r id name timestamp cwd; do
    [[ -z "$id" ]] && continue
    # Backfill cwd if missing (migration from old format)
    if [[ -z "$cwd" ]] && [[ -d "$SESSION_STATE_DIR/$id" ]]; then
      cwd=$(grep '^cwd:' "$SESSION_STATE_DIR/$id/workspace.yaml" 2>/dev/null | sed 's/^cwd: *//' || true)
    fi
    # Refresh unnamed entries
    if [[ "$name" == "unnamed" || -z "$name" ]] && [[ -d "$SESSION_STATE_DIR/$id" ]]; then
      name=$(get_session_name "$SESSION_STATE_DIR/$id")
    fi
    echo "${id}|${name}|${timestamp}|${cwd}"
  done < "$SESSIONS_FILE" > "$tmp"
  mv "$tmp" "$SESSIONS_FILE"
}

# --- Detect which session copilot just used ---
detect_new_session() {
  local before_file="$1"

  # Check for newly created session dirs
  for dir in "$SESSION_STATE_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    local id
    id=$(basename "$dir")
    if ! grep -q "^${id}$" "$before_file" 2>/dev/null; then
      local yaml="$dir/workspace.yaml"
      if [[ -f "$yaml" ]]; then
        local cwd
        cwd=$(grep '^cwd:' "$yaml" 2>/dev/null | sed 's/^cwd: *//' || true)
        if [[ "$cwd" == "$PWD" ]]; then
          echo "$id"; return
        fi
      fi
    fi
  done
}

# --- Strictly detect the session a brand-new `copilot` run created ---
# Used ONLY to decide context-metrics enrollment (the keep/rename/delete
# flow keeps using detect_new_session above, unchanged). Never guesses:
#   prints the id and returns 0 only if exactly ONE session directory
#     appeared during the run and its workspace.yaml cwd is $PWD;
#   returns 1 (no output) if no new session directory appeared;
#   returns 2 (no output) if the result is ambiguous (several new
#     directories, e.g. a concurrent Copilot session, or a cwd mismatch).
detect_enrollable_new_session() {
  local before_file="$1"
  local found="" count=0 dir id
  for dir in "$SESSION_STATE_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    id=$(basename "$dir")
    if ! grep -qxF -- "$id" "$before_file" 2>/dev/null; then
      count=$((count + 1))
      found="$id"
    fi
  done
  [[ $count -eq 0 ]] && return 1
  [[ $count -gt 1 ]] && return 2
  local cwd
  cwd=$(grep '^cwd:' "$SESSION_STATE_DIR/$found/workspace.yaml" 2>/dev/null | sed 's/^cwd: *//' || true)
  [[ "$cwd" == "$PWD" ]] || return 2
  echo "$found"
  return 0
}

# --- Warn that a brand-new run's session was not enrolled for metrics ---
# Shared by the stop flow (ambiguous mode) and run_copilot (when no session
# could be attributed to the keep/rename/delete flow at all, e.g. the only
# new session directory's workspace cwd differs from $PWD). Never invokes
# the helper, never creates a sidecar.
warn_context_not_enrolled() {
  echo -e "${YELLOW}Warning: could not unambiguously identify the new session created by this run (e.g. another Copilot session started concurrently, or its workspace directory differs from the current directory) — context metrics were not recorded for it.${RESET}" >&2
}

# --- Show (and record) context metrics when a session stops ---
#   $1 = session id, $2 = mode, $3 = epoch just before `copilot` launched
# Modes:
#   enroll    - brand-new session created by this copilot-s run, detected
#               unambiguously: create its sidecar, then show metrics.
#   ambiguous - brand-new run whose session could not be identified with
#               certainty: warn, record nothing.
#   update    - anything else (resume): refresh + show ONLY if the session
#               already has a sidecar; legacy sessions are left untouched
#               (no helper process, no events scan, no output).
# Never fatal: every failure is a visible stderr warning.
show_session_context_metrics() {
  local session_id="${1:-}" mode="${2:-update}" started_epoch="${3:-}"
  [[ -z "$session_id" ]] && return 0
  local session_dir="$SESSION_STATE_DIR/$session_id"

  local extra=()
  case "$mode" in
    ambiguous)
      warn_context_not_enrolled
      return 0
      ;;
    enroll)
      extra=(--enroll --expect-cwd "$PWD")
      [[ -n "$started_epoch" ]] && extra+=(--started-after "$started_epoch")
      ;;
    *)
      [[ -f "$session_dir/$CONTEXT_SIDECAR_NAME" ]] || return 0
      ;;
  esac

  if [[ ! -f "$TASK_REPORT_HELPER" ]]; then
    echo -e "${YELLOW}Warning: task report helper not found at $TASK_REPORT_HELPER — context metrics not recorded.${RESET}" >&2
    return 0
  fi
  command -v python3 >/dev/null 2>&1 || { echo -e "${YELLOW}Warning: python3 not found — context metrics not recorded.${RESET}" >&2; return 0; }

  local out="" rc=0
  out=$(python3 "$TASK_REPORT_HELPER" context-update \
      --session-id "$session_id" \
      --session-dir "$session_dir" \
      "${extra[@]+"${extra[@]}"}") || rc=$?
  if [[ $rc -ne 0 ]]; then
    echo -e "${YELLOW}Warning: context metrics update failed (exit $rc); session handling continues normally.${RESET}" >&2
  fi
  if [[ -n "$out" ]]; then
    local line
    while IFS= read -r line; do
      [[ -n "$line" ]] && echo -e "  ${DIM}${line}${RESET}"
    done <<< "$out"
  fi
  return 0
}

# --- Load compact context labels for the listed sessions ---
# Fills CONTEXT_LABELS (parallel to $FILTERED_FILE lines) from EXISTING
# sidecars only. Costs nothing for legacy sessions: the helper is only
# spawned (once, for the whole list) if at least one listed session has a
# sidecar file; it never reads events logs. Failures just leave labels empty.
load_context_labels() {
  CONTEXT_LABELS=()
  [[ -n "${FILTERED_FILE:-}" && -f "$FILTERED_FILE" ]] || return 0
  local any=false id _rest
  while IFS='|' read -r id _rest; do
    if [[ -n "$id" && -f "$SESSION_STATE_DIR/$id/$CONTEXT_SIDECAR_NAME" ]]; then
      any=true
      break
    fi
  done < "$FILTERED_FILE"
  [[ "$any" == "true" ]] || return 0
  [[ -f "$TASK_REPORT_HELPER" ]] || return 0
  command -v python3 >/dev/null 2>&1 || return 0

  local out="" line
  out=$(cut -d'|' -f1 "$FILTERED_FILE" | python3 "$TASK_REPORT_HELPER" context-list \
      --session-state-dir "$SESSION_STATE_DIR" 2>/dev/null) || return 0
  while IFS= read -r line; do
    CONTEXT_LABELS+=("$line")
  done <<< "$out"
  return 0
}

# --- Import any sessions from copilot state not yet tracked ---
sync_sessions() {
  [[ -d "$SESSION_STATE_DIR" ]] || return 0
  touch "$SESSIONS_FILE"
  for dir in "$SESSION_STATE_DIR"/*/; do
    [[ -d "$dir" ]] || continue
    local id
    id=$(basename "$dir")
    # Skip if already tracked
    grep -q "^${id}|" "$SESSIONS_FILE" 2>/dev/null && continue
    local yaml="$dir/workspace.yaml"
    [[ -f "$yaml" ]] || continue
    local cwd created_at
    cwd=$(grep '^cwd:' "$yaml" 2>/dev/null | sed 's/^cwd: *//' || true)
    created_at=$(grep '^created_at:' "$yaml" 2>/dev/null | sed 's/^created_at: *//' || true)
    local display_name
    display_name=$(get_session_name "$dir")
    echo "${id}|${display_name}|${created_at}|${cwd}" >> "$SESSIONS_FILE"
  done
}

# --- Display session list ---
list_sessions() {
  # Import/refresh the index only while holding the lock; if it is busy,
  # list the index as it is without modifying it.
  if registry_lock; then
    sync_sessions
    if [[ -f "$SESSIONS_FILE" ]] && [[ -s "$SESSIONS_FILE" ]]; then
      refresh_session_names
    fi
    registry_unlock
  fi

  if [[ ! -f "$SESSIONS_FILE" ]] || [[ ! -s "$SESSIONS_FILE" ]]; then
    return 1
  fi

  # Clean up previous filtered file if any
  if [[ -n "${FILTERED_FILE:-}" ]] && [[ -f "$FILTERED_FILE" ]]; then
    rm -f "$FILTERED_FILE"
  fi
  FILTERED_FILE=$(mktemp)

  local has_entries=false
  while IFS='|' read -r id name timestamp cwd; do
    [[ -z "$id" ]] && continue
    if [[ "$SHOW_ALL" == "true" ]] || [[ "$cwd" == "$PWD" ]]; then
      echo "${id}|${name}|${timestamp}|${cwd}" >> "$FILTERED_FILE"
      has_entries=true
    fi
  done < "$SESSIONS_FILE"

  if [[ "$has_entries" == "false" ]]; then
    rm -f "$FILTERED_FILE"
    FILTERED_FILE=""
    return 1
  fi

  if [[ "$SHOW_ALL" == "true" ]]; then
    echo -e "\n${BOLD}${CYAN}╔══ All Sessions ══╗${RESET}"
  else
    echo -e "\n${BOLD}${CYAN}╔══ Sessions ($(short_path "$PWD")) ══╗${RESET}"
  fi
  echo ""

  load_context_labels

  local i=1
  while IFS='|' read -r id name timestamp cwd; do
    [[ -z "$id" ]] && continue
    local short_id="${id:0:8}"
    local display_date=""
    if [[ -n "$timestamp" ]]; then
      display_date=$(format_timestamp "$timestamp")
    fi

    local status
    if [[ -d "$SESSION_STATE_DIR/$id" ]]; then
      status="${GREEN}●${RESET} "
    else
      status="${DIM}○${RESET} "
    fi

    local dir_info=""
    if [[ "$SHOW_ALL" == "true" && -n "$cwd" ]]; then
      dir_info="  ${DIM}$(short_path "$cwd")${RESET}"
    fi

    local ctx_info=""
    local ctx_label="${CONTEXT_LABELS[$((i - 1))]:-}"
    if [[ -n "$ctx_label" ]]; then
      ctx_info="  ${DIM}(${ctx_label})${RESET}"
    fi

    echo -e "  ${status}${BOLD}${i})${RESET} ${name:-unnamed}  ${DIM}[${short_id}…]  ${display_date}${RESET}${dir_info}${ctx_info}"
    i=$((i + 1))
  done < "$FILTERED_FILE"

  echo ""
  if [[ "$SHOW_ALL" != "true" ]]; then
    echo -e "  ${BOLD}${CYAN}a)${RESET} Show all sessions"
  fi
  echo -e "  ${BOLD}${GREEN}n)${RESET} New session"
  echo -e "  ${BOLD}${YELLOW}d)${RESET} Delete a session"
  echo -e "  ${BOLD}${YELLOW}c)${RESET} Clean up empty sessions (recoverable)"
  echo -e "  ${BOLD}${YELLOW}r)${RESET} Clean run reports and private RTK data (recoverable)"
  echo -e "  ${BOLD}${RED}x)${RESET} Permanently purge a quarantined-session batch (irreversible)"
  echo -e "  ${BOLD}${CYAN}p)${RESET} Refresh subagent models from current prices"
  echo -e "  ${BOLD}q)${RESET} Quit"
  echo ""
  return 0
}

# --- Post-session: keep/delete then rename ---
post_session() {
  local session_id="${1:-}"
  local task_id="${2:-}"
  local metrics_mode="${3:-update}"
  local started_epoch="${4:-}"
  [[ -z "$session_id" ]] && return 0

  local session_dir="$SESSION_STATE_DIR/$session_id"
  [[ -d "$session_dir" ]] || return 0

  # Update the task usage report FIRST, while events.jsonl still exists on
  # disk — this must run regardless of whether the user then keeps, renames,
  # or deletes the session below, and must never abort this script.
  update_task_report "$session_id" "$task_id"
  # Finalize this launch's session report (no-op if none is pending) while
  # the session's files still exist and right after the task ingest.
  finalize_run_report

  local created_at cwd
  created_at=$(grep '^created_at:' "$session_dir/workspace.yaml" 2>/dev/null | sed 's/^created_at: *//' || true)
  cwd=$(grep '^cwd:' "$session_dir/workspace.yaml" 2>/dev/null | sed 's/^cwd: *//' || true)

  # Prefer user's previously saved name
  local display_name=""
  if [[ -f "$SESSIONS_FILE" ]]; then
    display_name=$(grep "^${session_id}|" "$SESSIONS_FILE" 2>/dev/null | head -1 | cut -d'|' -f2 || true)
  fi
  if [[ -z "$display_name" || "$display_name" == "unnamed" ]]; then
    display_name=$(get_session_name "$session_dir")
  fi

  echo ""
  echo -e "${BOLD}Session:${RESET} ${display_name}  ${DIM}[${session_id:0:8}…]${RESET}"
  # Context metrics (enrolled copilot-s sessions only) are shown before the
  # keep/rename/delete choice; a later delete removes them with the session.
  show_session_context_metrics "$session_id" "$metrics_mode" "$started_epoch"
  echo -ne "  ${GREEN}k)${RESET} Keep  ${YELLOW}r)${RESET} Rename  ${RED}d)${RESET} Delete  ${DIM}[K/r/d]:${RESET} "
  local action=""
  prompt_read action

  case "${action:-}" in
    d|D)
      if [[ -f "$SESSIONS_FILE" ]] && ! registry_lock; then
        echo -e "${YELLOW}Session not deleted (session list busy). Delete it later from the menu.${RESET}"
        return 0
      fi
      # Remove from sessions file
      if [[ -f "$SESSIONS_FILE" ]]; then
        local tmp
        tmp=$(mktemp)
        while IFS='|' read -r eid ename ets ecwd; do
          [[ -z "$eid" ]] && continue
          if [[ "$eid" != "$session_id" ]]; then
            echo "${eid}|${ename}|${ets}|${ecwd}"
          fi
        done < "$SESSIONS_FILE" > "$tmp"
        mv "$tmp" "$SESSIONS_FILE"
        registry_unlock
      fi
      # Remove from disk
      rm -rf "$session_dir"
      echo -e "${RED}Session deleted.${RESET}"
      ;;
    r|R)
      echo -ne "${YELLOW}New name: ${RESET}"
      local new_name=""
      prompt_read new_name
      new_name="${new_name//|/ }"
      new_name="${new_name#"${new_name%%[![:space:]]*}"}"
      new_name="${new_name%"${new_name##*[![:space:]]}"}"
      if [[ -n "$new_name" ]]; then
        display_name="$new_name"
      fi
      if save_session "$session_id" "$display_name" "$created_at" "$cwd" "true"; then
        echo -e "${GREEN}Session saved:${RESET} ${display_name} ${DIM}[${session_id:0:8}…]${RESET}"
      else
        echo -e "${YELLOW}Session kept, but the new name was NOT saved (the session list file was not replaced). Rename it later from the menu.${RESET} ${DIM}[${session_id:0:8}…]${RESET}"
      fi
      ;;
    *)
      # Keep with current name (default)
      if save_session "$session_id" "$display_name" "$created_at" "$cwd"; then
        echo -e "${GREEN}Session kept:${RESET} ${display_name} ${DIM}[${session_id:0:8}…]${RESET}"
      else
        echo -e "${YELLOW}Session kept, but its session-list entry was NOT updated (it is re-imported on a later listing).${RESET} ${DIM}[${session_id:0:8}…]${RESET}"
      fi
      ;;
  esac
}

# Required single-value options from Copilot CLI 1.0.109 --help. Protect
# their separate operands from wrapper flag/name/selector detection. Optional
# and variadic options only take non-option operands, so need no skipping.
copilot_option_takes_value() {
  case "$1" in
    --add-dir|--add-github-mcp-tool|--add-github-mcp-toolset|\
    --additional-mcp-config|--agent|--attachment|--auto-tier|-C|--context|\
    --disable-mcp-server|--dynamic-retrieval|--enable-mcp-server|\
    --extension-sdk-path|-i|--interactive|--log-dir|--log-level|\
    --max-ai-credits|--max-autopilot-continues|--mcp-github-auth|--mode|\
    --model|-n|--name|--output-format|--plugin-dir|-p|--prompt|\
    --reasoning-effort|--session-id|--stream|--usage-output-file)
      return 0 ;;
    *) return 1 ;;
  esac
}

# --- Launch copilot ---
run_copilot() {
  local session_id="${1:-}"
  shift 2>/dev/null || true

  # copilot-s always uses Copilot's automatic balance tier. Remove caller-
  # supplied model and auto-tier options in either supported spelling before
  # appending the forced values before --, so caller options cannot override
  # them. Keep the end marker and its positional remainder untouched.
  local -a copilot_args=() positional_args=()
  local caller_names_session=false caller_selects_session=false caller_usage_file=false
  CALLER_PLUGIN_DIRS=()
  CALLER_SESSION_CWD_UNCERTAIN=false
  SESSION_PROJECT_DIRS=()
  SESSION_PROJECT_UNKNOWN=""
  local caller_c_dir="" add_dir
  local -a caller_add_dirs=()
  [[ -n "$session_id" ]] && CALLER_SESSION_CWD_UNCERTAIN=true
  while [[ $# -gt 0 ]]; do
    # Options that decide which directory the session runs in (recorded
    # only; every option is still handled unchanged by the case below).
    case "$1" in
      -C)
        CALLER_SESSION_CWD_UNCERTAIN=true
        if [[ $# -gt 1 && "$2" != "--" && -n "$2" ]]; then
          caller_c_dir="$2"
        else
          SESSION_PROJECT_UNKNOWN="-C without a directory"
        fi
        ;;
      -C?*)
        CALLER_SESSION_CWD_UNCERTAIN=true
        caller_c_dir="${1#-C}"
        caller_c_dir="${caller_c_dir#=}"
        if [[ -z "$caller_c_dir" ]]; then
          SESSION_PROJECT_UNKNOWN="-C without a directory"
        fi
        ;;
      --worktree|--worktree=*)
        CALLER_SESSION_CWD_UNCERTAIN=true
        SESSION_PROJECT_UNKNOWN="--worktree: the session runs in a worktree copilot-s does not inspect"
        ;;
      --resume=*)
        note_resumed_session_dir "${1#--resume=}"
        ;;
      -r?*)
        note_resumed_session_dir "${1#-r}"
        ;;
      --resume|-r|--continue)
        SESSION_PROJECT_UNKNOWN="$1 without a session id: copilot-s cannot tell which session, and so which directory, Copilot will open"
        ;;
      --connect|--connect=*)
        SESSION_PROJECT_UNKNOWN="--connect: the session runs in a directory copilot-s cannot inspect"
        ;;
      --session-id)
        if [[ $# -gt 1 && "$2" != "--" ]]; then
          note_selected_session_dir "$2"
        fi
        ;;
      --session-id=*)
        note_selected_session_dir "${1#--session-id=}"
        ;;
      --add-dir)
        # Additional directories also feed Copilot's hook discovery. The
        # operand (consumed unchanged by the case below) is recorded raw;
        # a missing one is recorded empty and makes the directory unknown.
        if [[ $# -gt 1 && "$2" != "--" ]]; then
          caller_add_dirs+=("$2")
        else
          caller_add_dirs+=("")
        fi
        ;;
      --add-dir=*)
        caller_add_dirs+=("${1#--add-dir=}")
        ;;
    esac
    case "$1" in
      --)
        positional_args=("$@")
        break
        ;;
      --plugin-dir|--plugin-dir=*)
        # Caller plugins pass through untouched; in RTK mode they are
        # inspected (never modified) by the preflight before launch.
        if [[ "$1" == "--plugin-dir" ]]; then
          copilot_args+=("$1")
          shift
          if [[ $# -gt 0 && "$1" != "--" ]]; then
            CALLER_PLUGIN_DIRS+=("$1")
            copilot_args+=("$1")
            shift
          else
            CALLER_PLUGIN_DIRS+=("")
          fi
          continue
        fi
        CALLER_PLUGIN_DIRS+=("${1#--plugin-dir=}")
        copilot_args+=("$1")
        shift
        ;;
      --usage-output-file|--usage-output-file=*)
        # Caller-owned usage file: passed through untouched; copilot-s then
        # neither adds its own nor reads/overrides the caller's path.
        caller_usage_file=true
        if [[ "$1" == "--usage-output-file" ]]; then
          copilot_args+=("$1")
          shift
          if [[ $# -gt 0 && "$1" != "--" ]]; then
            copilot_args+=("$1")
            shift
          fi
          continue
        fi
        copilot_args+=("$1")
        shift
        ;;
      --model|--auto-tier)
        shift
        if [[ $# -gt 0 && "$1" != "--" ]]; then
          shift
        fi
        ;;
      --model=*|--auto-tier=*)
        shift
        ;;
      --name|-n)
        caller_names_session=true
        copilot_args+=("$1")
        shift
        if [[ $# -gt 0 && "$1" != "--" ]]; then
          copilot_args+=("$1")
          shift
        fi
        ;;
      --name=*|-n?*)
        caller_names_session=true
        copilot_args+=("$1")
        shift
        ;;
      --resume|-r|--resume=*|-r?*|--continue|--session-id|--session-id=*|--connect|--connect=*)
        # These can select an existing session. Leave them untouched and
        # never add a prompted new-session name to a caller-selected session.
        caller_selects_session=true
        CALLER_SESSION_CWD_UNCERTAIN=true
        if [[ "$1" == "--session-id" ]]; then
          copilot_args+=("$1")
          shift
          if [[ $# -gt 0 && "$1" != "--" ]]; then
            copilot_args+=("$1")
            shift
          fi
          continue
        fi
        copilot_args+=("$1")
        shift
        ;;
      *)
        local takes_value=false
        if copilot_option_takes_value "$1"; then
          takes_value=true
        fi
        copilot_args+=("$1")
        shift
        if [[ "$takes_value" == "true" && $# -gt 0 && "$1" != "--" ]]; then
          copilot_args+=("$1")
          shift
        fi
        ;;
    esac
  done
  copilot_args+=(--model auto --auto-tier balance)

  # Directories the session may run in: a menu-resumed session's recorded
  # directory (Copilot switches to it on resume), an explicit -C target, and
  # always the launch directory itself (conservative union).
  if [[ -n "$session_id" ]]; then
    note_resumed_session_dir "$session_id"
  fi
  if [[ -n "$caller_c_dir" ]]; then
    if [[ "$caller_c_dir" != /* ]]; then
      caller_c_dir="$PWD/$caller_c_dir"
    fi
    SESSION_PROJECT_DIRS+=("$caller_c_dir")
  fi
  SESSION_PROJECT_DIRS+=("$PWD")
  # --add-dir operands (every occurrence, both spellings). Copilot resolves a
  # relative one against the SESSION working directory: that is the -C
  # target or the launch directory for a new session, but for a resumed or
  # selected session it is the session's own directory, so a relative
  # operand there is unknown (use an absolute path) rather than guessed.
  for add_dir in "${caller_add_dirs[@]+"${caller_add_dirs[@]}"}"; do
    if [[ -z "$add_dir" ]]; then
      SESSION_PROJECT_UNKNOWN="--add-dir without a directory"
    elif [[ "$add_dir" == /* ]]; then
      SESSION_PROJECT_DIRS+=("$add_dir")
    elif [[ -n "$session_id" || "$caller_selects_session" == "true" ]]; then
      SESSION_PROJECT_UNKNOWN="relative --add-dir $add_dir with a resumed or selected session: Copilot resolves it against that session's directory; pass an absolute path"
    elif [[ -n "$caller_c_dir" ]]; then
      SESSION_PROJECT_DIRS+=("$caller_c_dir/$add_dir")
    else
      SESSION_PROJECT_DIRS+=("$PWD/$add_dir")
    fi
  done

  # Per-launch session report (both modes). In RTK mode this also runs the
  # full RTK preflight and exits before any prompt or launch if it fails.
  start_run_report "$session_id" "$caller_selects_session" "$caller_usage_file"
  if [[ "$RUN_REPORT_PENDING" == "true" && -n "$RUN_USAGE_FILE" ]]; then
    copilot_args+=(--usage-output-file "$RUN_USAGE_FILE")
  fi
  if [[ "$RTK_MODE" == "true" ]]; then
    copilot_args+=(--plugin-dir "$RTK_PLUGIN_DIR")
  fi

  # Use Copilot's native name-on-launch option, not a wrapper-only alias
  # written after exit. Copilot owns persistence and any later /rename.
  # Explicit caller names/selectors take precedence over this prompt.
  local session_name=""
  if [[ -z "$session_id" && "$caller_names_session" == "false" && "$caller_selects_session" == "false" ]]; then
    echo -ne "${YELLOW}Session name (Enter for automatic): ${RESET}" >&2
    prompt_read session_name
    session_name="${session_name//|/ }"
    session_name="${session_name#"${session_name%%[![:space:]]*}"}"
    session_name="${session_name%"${session_name##*[![:space:]]}"}"
    if [[ -n "$session_name" ]]; then
      copilot_args+=("--name=$session_name")
    fi
  fi
  copilot_args+=("${positional_args[@]}")

  # Resolve which task this run's usage should be attributed to,
  # before copilot starts (prompts once only for a brand-new session with no
  # task ID detectable from the branch).
  local task_id
  task_id=$(resolve_task_id "$session_id")

  # Snapshot existing session dirs
  local before_file
  before_file=$(mktemp)
  if [[ -d "$SESSION_STATE_DIR" ]]; then
    ls "$SESSION_STATE_DIR" > "$before_file" 2>/dev/null || true
  fi

  # Launch time, used to sanity-check that a detected brand-new session was
  # really created by this run before enrolling it for context metrics.
  local started_epoch
  started_epoch=$(date +%s)

  if [[ "$RTK_MODE" == "true" ]]; then
    apply_rtk_env
    echo -e "${YELLOW}Mode: RTK${RESET} ${DIM}— rtk ${SUPPORTED_RTK_LABEL} hook for this launch only; allowlisted test/build commands become \`rtk <command>\` (Copilot permissions unchanged). Run ${COPILOT_S_RUN_ID}${RESET}"
  else
    echo -e "${DIM}Mode: normal${RESET}"
  fi
  echo -e "${CYAN}Starting copilot...${RESET}\n"
  start_rtk_publisher
  local copilot_rc=0
  if [[ -n "$session_id" ]]; then
    copilot --resume="$session_id" "${copilot_args[@]}" || copilot_rc=$?
  else
    copilot "${copilot_args[@]}" || copilot_rc=$?
  fi
  REPORT_EXIT_CODE="$copilot_rc"
  REPORT_LAUNCHED_EPOCH="$started_epoch"
  REPORT_ENDED_EPOCH="$(date +%s)"
  stop_rtk_publisher

  flush_stdin

  # Figure out which session was used
  local detected_id
  detected_id=$(detect_new_session "$before_file") || true

  # Strict detection remains the authority for context-metrics enrollment.
  # Naming is handled by Copilot itself at launch, without guessing an ID.
  local enroll_id="" enroll_rc=0
  if [[ -z "$session_id" ]]; then
    enroll_id=$(detect_enrollable_new_session "$before_file") || enroll_rc=$?
  fi

  # Context-metrics enrollment is decided independently and conservatively:
  # only a brand-new run ("n"/no sessions) whose single new session
  # directory is unambiguous gets enrolled; resumes only refresh sessions
  # that are already enrolled.
  local metrics_mode="update"
  if [[ -z "$session_id" ]]; then
    if [[ $enroll_rc -eq 0 && -n "$enroll_id" && "$enroll_id" == "${detected_id:-}" ]]; then
      metrics_mode="enroll"
    elif [[ $enroll_rc -ne 1 ]]; then
      metrics_mode="ambiguous"
    fi
  fi
  rm -f "$before_file"

  # Session report link: the resumed id (helper side), or ONLY the strictly
  # detected single new session directory — never the looser detection
  # above. The helper cross-checks it against hook/OTEL evidence and records
  # "unknown" on any ambiguity.
  if [[ -z "$session_id" && $enroll_rc -eq 0 && -n "$enroll_id" ]]; then
    REPORT_SESSION_ID="$enroll_id"
  fi

  local final_id="${detected_id:-$session_id}"
  # detect_new_session only attributes a new directory whose cwd is $PWD, so
  # a new session with a mismatched (or missing) workspace cwd leaves no id
  # for the stop flow, and post_session would return before it could warn.
  # Surface the non-enrollment here instead; still no helper call/sidecar.
  if [[ -z "$final_id" && "$metrics_mode" == "ambiguous" ]]; then
    warn_context_not_enrolled
  fi
  post_session "${final_id:-}" "$task_id" "$metrics_mode" "$started_epoch"
  # Safety net: finalize the run report even when the stop flow had no
  # session to show (no-op if post_session already finalized it).
  finalize_run_report
  exit 0
}

# --- Delete sessions ---
delete_session() {
  echo -e "${YELLOW}Enter session numbers to delete:${RESET}"
  echo -e "  ${DIM}Examples: 1 3 5 · 1-5 · 2 7-10 · all${RESET}"
  echo -ne "${YELLOW}> ${RESET}"
  local del_input=""
  prompt_read del_input

  if [[ -z "$del_input" ]]; then
    echo "Cancelled."
    return
  fi

  # Build list of line numbers to delete
  local total
  total=$(wc -l < "$FILTERED_FILE" | tr -d ' ')
  local numbers=()

  if [[ "$del_input" == "all" ]]; then
    local n=1
    while [[ $n -le $total ]]; do
      numbers+=("$n")
      n=$((n + 1))
    done
  else
    for token in $del_input; do
      if [[ "$token" =~ ^([0-9]+)-([0-9]+)$ ]]; then
        local from="${BASH_REMATCH[1]}" to="${BASH_REMATCH[2]}"
        local n=$from
        while [[ $n -le $to ]]; do
          numbers+=("$n")
          n=$((n + 1))
        done
      elif [[ "$token" =~ ^[0-9]+$ ]]; then
        numbers+=("$token")
      fi
    done
  fi

  if [[ ${#numbers[@]} -eq 0 ]]; then
    echo "Cancelled."
    return
  fi

  # Collect sessions to delete and preview them
  local del_ids=()
  local del_names=()
  echo ""
  for num in "${numbers[@]}"; do
    local line
    line=$(sed -n "${num}p" "$FILTERED_FILE" 2>/dev/null) || true
    if [[ -n "$line" ]]; then
      local did dname
      did=$(echo "$line" | cut -d'|' -f1)
      dname=$(echo "$line" | cut -d'|' -f2)
      del_ids+=("$did")
      del_names+=("$dname")
      echo -e "  ${RED}✕${RESET} ${dname}  ${DIM}[${did:0:8}…]${RESET}"
    fi
  done

  if [[ ${#del_ids[@]} -eq 0 ]]; then
    echo "No valid sessions selected."
    return
  fi

  echo ""
  echo -ne "${RED}Delete ${#del_ids[@]} session(s) and their history? (y/N): ${RESET}"
  local confirm=""
  prompt_read confirm

  if [[ "$confirm" == "y" || "$confirm" == "Y" ]]; then
    # Build lookup string of IDs to delete
    local del_lookup=""
    for did in "${del_ids[@]}"; do
      del_lookup="${del_lookup}${did}:"
    done

    # Rewrite sessions file excluding deleted IDs (nothing is deleted if the
    # session list is busy).
    if ! registry_lock; then
      echo "Cancelled — session list busy. Nothing was deleted."
      return
    fi
    local tmp
    tmp=$(mktemp)
    while IFS='|' read -r eid ename ets ecwd; do
      [[ -z "$eid" ]] && continue
      if [[ "$del_lookup" != *"${eid}:"* ]]; then
        echo "${eid}|${ename}|${ets}|${ecwd}"
      fi
    done < "$SESSIONS_FILE" > "$tmp"
    mv "$tmp" "$SESSIONS_FILE"
    registry_unlock

    # Remove session state directories from disk — but ingest any pending
    # usage into the Task report FIRST for each one, so bulk-deleting
    # sessions never silently drops usage that was never ingested yet.
    for did in "${del_ids[@]}"; do
      if [[ -d "$SESSION_STATE_DIR/$did" ]]; then
        local del_task_id
        del_task_id=$(resolve_task_id_noninteractive "$did")
        update_task_report "$did" "$del_task_id"
        rm -rf "${SESSION_STATE_DIR:?}/${did:?}"
      fi
    done

    echo -e "${GREEN}Deleted ${#del_ids[@]} session(s). Task usage reports for them (if any) remain at $(short_path "$TASK_REPORTS_DIR_DISPLAY").${RESET}"
  else
    echo "Cancelled."
  fi
}

# --- Recoverable cleanup of empty sessions (menu option c) ---
# Scope follows what the list is showing: the exact current directory, or
# every directory when the list shows all sessions. The helper's preview is
# read-only; only the exact previewed candidates are passed to `apply`, which
# re-validates each one and moves it into ~/.copilot-s-quarantine (never
# deletes). Any helper failure is shown and leaves the session list usable.
# Before the preview, an explicit opt-in (default No) can include recent
# empty sessions (no 24h minimum age); the same --include-recent choice is
# passed to both preview and apply, and the helper refuses a mismatch.
cleanup_empty_sessions() {
  if [[ ! -f "$SESSION_CLEANUP_HELPER" ]]; then
    echo -e "${RED}Session cleanup helper not found at $SESSION_CLEANUP_HELPER — nothing was changed. Set COPILOT_SESSION_CLEANUP_HELPER or re-run the installer.${RESET}" >&2
    return 0
  fi
  command -v python3 >/dev/null 2>&1 || { echo -e "${RED}python3 not found — nothing was changed.${RESET}" >&2; return 0; }

  local -a path_args=(--session-state-dir "$SESSION_STATE_DIR" --sessions-file "$SESSIONS_FILE" --quarantine-dir "$SESSION_QUARANTINE_DIR")
  local -a scope_args=(--cwd "$PWD")
  [[ "$SHOW_ALL" == "true" ]] && scope_args=(--all)

  # Opt-in only: anything other than y/yes (including Enter or EOF) keeps the
  # default 24h minimum age.
  local -a policy_args=()
  local include_recent=""
  echo -ne "${YELLOW}Also include recent empty sessions (created or changed within the last 24h)? [y/N]: ${RESET}"
  prompt_read include_recent
  case "$include_recent" in
    y|Y|yes|YES|Yes)
      policy_args=(--include-recent)
      echo -e "${YELLOW}Recent sessions included. Warning: a recent empty session may have been created moments ago (e.g. by a Copilot that is still starting — its origin is not known) and could start being used right after the open-file check. That race is accepted: sessions are only moved to quarantine and can be restored.${RESET}"
      ;;
  esac

  local out="" rc=0 line tab=$'\t'
  local -a candidates=()
  out=$(python3 "$SESSION_CLEANUP_HELPER" "${path_args[@]}" preview "${scope_args[@]}" \
    "${policy_args[@]+"${policy_args[@]}"}") || rc=$?
  echo ""
  while IFS= read -r line; do
    if [[ "$line" == "CANDIDATE${tab}"* ]]; then
      candidates+=("${line#"CANDIDATE${tab}"}")
    else
      echo "$line"
    fi
  done <<< "$out"
  if [[ $rc -ne 0 ]]; then
    echo -e "${RED}Cleanup preview failed (exit $rc) — nothing was changed.${RESET}" >&2
    return 0
  fi
  [[ ${#candidates[@]} -eq 0 ]] && return 0

  echo -ne "${YELLOW}Type 'yes' to move ${#candidates[@]} session(s) to quarantine (anything else cancels): ${RESET}"
  local confirm=""
  prompt_read confirm
  if [[ "$confirm" != "yes" ]]; then
    echo "Cancelled. Nothing was changed."
    return 0
  fi

  rc=0
  printf '%s\n' "${candidates[@]}" | python3 "$SESSION_CLEANUP_HELPER" "${path_args[@]}" apply "${scope_args[@]}" \
    "${policy_args[@]+"${policy_args[@]}"}" || rc=$?
  if [[ $rc -ne 0 ]]; then
    echo -e "${YELLOW}Warning: cleanup finished with problems (exit $rc) — see above. Nothing was deleted.${RESET}" >&2
  fi
  return 0
}

# --- Permanent purge of ONE quarantine batch (menu x; run reports: r -> 4) ---
# quarantine_purge_pick LABEL HELPER [HELPER ARGS...]
# Shows the helper's read-only `purge-list` (fills the choices from its
# PURGEABLE lines only), lets you pick ONE batch by number (Enter cancels),
# then runs the helper's interactive `purge --batch <batch>` directly on the
# terminal (output not captured): it prints the exact inventory and the
# estimated reclaimable space and deletes only after YOU type, on the
# terminal, the exact phrase it shows (kind, full batch name, snapshot id).
# copilot-s never answers for you; there is no yes/force bypass. Every
# outcome returns to the caller; nothing launches Copilot.
quarantine_purge_pick() {
  local label="$1"
  shift
  local out="" rc=0 line tab=$'\t'
  local -a batches=()
  out=$(python3 "$@" purge-list) || rc=$?
  echo ""
  while IFS= read -r line; do
    if [[ "$line" == "PURGEABLE${tab}"* ]]; then
      batches+=("${line#"PURGEABLE${tab}"}")
    else
      echo "$line"
    fi
  done <<< "$out"
  if [[ $rc -ne 0 ]]; then
    echo -e "${RED}Listing ${label} quarantine batches failed (exit $rc) — nothing was deleted.${RESET}" >&2
    return 0
  fi
  if [[ ${#batches[@]} -eq 0 ]]; then
    echo "No ${label} quarantine batch can be purged right now. Nothing was deleted."
    return 0
  fi
  echo ""
  local i=1 b
  for b in "${batches[@]}"; do
    echo -e "  ${BOLD}${i})${RESET} $b"
    i=$((i + 1))
  done
  echo -ne "${BOLD}Batch to purge PERMANENTLY (number; Enter cancels): ${RESET}"
  local pick=""
  prompt_read pick
  if [[ ! "$pick" =~ ^[0-9]+$ ]] || [[ "$pick" -lt 1 ]] || [[ "$pick" -gt ${#batches[@]} ]]; then
    echo "Cancelled. Nothing was deleted."
    return 0
  fi
  local batch="${batches[$((pick - 1))]}"
  if [[ ! "$batch" =~ ^[0-9]{8}-[0-9]{6}-[0-9a-f]{8}$ ]]; then
    echo -e "${RED}Unexpected batch name — nothing was deleted.${RESET}" >&2
    return 0
  fi
  echo ""
  rc=0
  python3 "$@" purge --batch "$batch" || rc=$?
  if [[ $rc -ne 0 ]]; then
    echo -e "${YELLOW}Warning: the purge did not complete (exit $rc) — see above. If it says the batch is PARTIALLY deleted, it can no longer be restored and is never retried automatically.${RESET}" >&2
  fi
  return 0
}

# Menu x (session list and "No saved sessions found" menu): permanent purge
# of one quarantined empty-session batch in ~/.copilot-s-quarantine. The
# recoverable `c` flow is unchanged and never deletes.
purge_session_quarantine() {
  if [[ ! -f "$SESSION_CLEANUP_HELPER" ]]; then
    echo -e "${RED}Session cleanup helper not found at $SESSION_CLEANUP_HELPER — nothing was deleted. Set COPILOT_SESSION_CLEANUP_HELPER or re-run the installer.${RESET}" >&2
    return 0
  fi
  command -v python3 >/dev/null 2>&1 || { echo -e "${RED}python3 not found — nothing was deleted.${RESET}" >&2; return 0; }
  echo -e "\n${BOLD}Quarantined empty sessions — PERMANENT purge (frees disk space; IRREVERSIBLE)${RESET}"
  local -a path_args=(--session-state-dir "$SESSION_STATE_DIR" --sessions-file "$SESSIONS_FILE" --quarantine-dir "$SESSION_QUARANTINE_DIR")
  quarantine_purge_pick "session" "$SESSION_CLEANUP_HELPER" "${path_args[@]}"
  return 0
}

# --- Subagent model refresh (menu option p) ---
# Fetches CURRENT official GitHub Copilot prices via copilot-model-refresh.py,
# shows the current/proposed routing table, and applies the frozen proposal
# only after an exact `yes` (default No). The helper refuses to apply if any
# input changed since the table was shown. Every outcome (applied, cancelled,
# no changes, offline/failed) prints the final effective routing and waits for
# Enter, then the caller returns to the menu — never launches `copilot`.
pause_for_menu() {
  local _ignored=""
  echo -ne "${DIM}Press Enter to return to the menu...${RESET}"
  prompt_read _ignored
  echo ""
  return 0
}

# Best-effort final table after a failed/refused propose or apply: the
# helper's read-only status. If even that fails (e.g. invalid settings or
# state), say so plainly instead of printing guessed defaults.
show_model_routing_status() {
  echo ""
  if ! python3 "$MODEL_REFRESH_HELPER" status; then
    echo -e "${RED}Current effective routing is unavailable (status failed, see above). Nothing was changed; no table is shown rather than a guessed one.${RESET}" >&2
  fi
  return 0
}

refresh_model_routing() {
  if [[ ! -f "$MODEL_REFRESH_HELPER" ]]; then
    echo -e "${RED}Model refresh helper not found at $MODEL_REFRESH_HELPER — subagent routing unchanged. Set COPILOT_MODEL_REFRESH_HELPER or re-run the installer.${RESET}" >&2
    pause_for_menu
    return 0
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo -e "${RED}python3 not found — subagent routing unchanged.${RESET}" >&2
    pause_for_menu
    return 0
  fi

  echo -e "\n${CYAN}Fetching current official GitHub Copilot prices...${RESET}"
  local out="" rc=0 line proposal_id="" tab=$'\t'
  out=$(python3 "$MODEL_REFRESH_HELPER" propose) || rc=$?
  echo ""
  while IFS= read -r line; do
    if [[ "$line" == "PROPOSAL${tab}"* ]]; then
      proposal_id="${line#"PROPOSAL${tab}"}"
    else
      echo "$line"
    fi
  done <<< "$out"

  if [[ $rc -eq 3 ]]; then
    : # No changes: the helper already printed the final (kept) routing.
  elif [[ $rc -ne 0 ]]; then
    echo -e "${RED}Model refresh did not complete (exit $rc) — subagent routing unchanged.${RESET}" >&2
    show_model_routing_status
  elif [[ ! "$proposal_id" =~ ^[0-9a-f]{16}$ ]]; then
    echo -e "${RED}Model refresh returned no valid proposal — subagent routing unchanged.${RESET}" >&2
    show_model_routing_status
  else
    echo ""
    echo -ne "${YELLOW}Type 'yes' to apply these subagent routing changes (categorical fit, not measured quality; anything else cancels): ${RESET}"
    local confirm="" apply_rc=0
    prompt_read confirm
    if [[ "$confirm" == "yes" ]]; then
      python3 "$MODEL_REFRESH_HELPER" apply --proposal-id "$proposal_id" || apply_rc=$?
      if [[ $apply_rc -ne 0 ]]; then
        echo -e "${RED}Apply did not complete (exit $apply_rc) — see the message above; current routing:${RESET}" >&2
        show_model_routing_status
      fi
    else
      python3 "$MODEL_REFRESH_HELPER" discard --proposal-id "$proposal_id" || true
    fi
  fi
  echo ""
  pause_for_menu
  return 0
}

# --- Recoverable cleanup of run reports and private RTK data (menu option r) ---
# Shells out to copilot-report-cleanup.py. Scope: every finalized per-launch
# run report under ~/.copilot/session-reports/runs (ALL workspaces — run
# records do not store the working directory), each with its private raw/
# data and, for RTK launches, its matching publication. The preview is
# read-only; only the exact previewed CANDIDATE lines (run id + fingerprint,
# same --include-recent choice) are passed to `apply` after an exact `yes`.
# Runs are MOVED to ~/.copilot/copilot-s-report-quarantine/<batch>/ — never
# deleted, and no disk space is freed. The submenu also lists batches and
# restores one (read-only plan, then exact `yes`). Every outcome (cancel,
# helper failure, success) returns to the menu; nothing launches Copilot.
report_cleanup_preview_apply() {
  local -a policy_args=()
  local include_recent=""
  echo -ne "${YELLOW}Also include run reports finalized within the last 24h? [y/N]: ${RESET}"
  prompt_read include_recent
  case "$include_recent" in
    y|Y|yes|YES|Yes)
      policy_args=(--include-recent)
      echo -e "${YELLOW}Recently finalized runs included (no minimum age). Active, unfinalized or uncertain runs are still always kept; quarantine is recoverable.${RESET}"
      ;;
  esac

  local out="" rc=0 line tab=$'\t'
  local -a candidates=()
  out=$(python3 "$REPORT_CLEANUP_HELPER" preview "${policy_args[@]+"${policy_args[@]}"}") || rc=$?
  echo ""
  while IFS= read -r line; do
    if [[ "$line" == "CANDIDATE${tab}"* ]]; then
      # Forwarded to `apply` exactly as printed (tag, id, fingerprint and
      # any include-recent marker) — the helper accepts only this format.
      candidates+=("$line")
    else
      echo "$line"
    fi
  done <<< "$out"
  if [[ $rc -ne 0 ]]; then
    echo -e "${RED}Run-report cleanup preview failed (exit $rc) — nothing was changed.${RESET}" >&2
    return 0
  fi
  [[ ${#candidates[@]} -eq 0 ]] && return 0

  echo -ne "${YELLOW}Type 'yes' to move ${#candidates[@]} run report(s) to quarantine (no disk space is freed; anything else cancels): ${RESET}"
  local confirm=""
  prompt_read confirm
  if [[ "$confirm" != "yes" ]]; then
    echo "Cancelled. Nothing was changed."
    return 0
  fi

  rc=0
  printf '%s\n' "${candidates[@]}" | python3 "$REPORT_CLEANUP_HELPER" apply \
    "${policy_args[@]+"${policy_args[@]}"}" || rc=$?
  if [[ $rc -ne 0 ]]; then
    echo -e "${YELLOW}Warning: run-report cleanup finished with problems (exit $rc) — see above. Nothing was deleted.${RESET}" >&2
  fi
  return 0
}

# Prints the helper's batch list (without machine lines) and fills
# REPORT_CLEANUP_BATCHES. Returns 1 if the helper failed.
REPORT_CLEANUP_BATCHES=()
report_cleanup_list() {
  local out="" rc=0 line tab=$'\t'
  REPORT_CLEANUP_BATCHES=()
  out=$(python3 "$REPORT_CLEANUP_HELPER" list) || rc=$?
  echo ""
  while IFS= read -r line; do
    if [[ "$line" == "BATCH${tab}"* ]]; then
      REPORT_CLEANUP_BATCHES+=("${line#"BATCH${tab}"}")
    else
      echo "$line"
    fi
  done <<< "$out"
  if [[ $rc -ne 0 ]]; then
    echo -e "${RED}Listing report quarantine batches failed (exit $rc).${RESET}" >&2
    return 1
  fi
  return 0
}

report_cleanup_restore() {
  report_cleanup_list || return 0
  [[ ${#REPORT_CLEANUP_BATCHES[@]} -eq 0 ]] && return 0
  echo ""
  local i=1 b
  for b in "${REPORT_CLEANUP_BATCHES[@]}"; do
    echo -e "  ${BOLD}${i})${RESET} $b"
    i=$((i + 1))
  done
  echo -ne "${BOLD}Batch to restore (number; Enter cancels): ${RESET}"
  local pick=""
  prompt_read pick
  if [[ ! "$pick" =~ ^[0-9]+$ ]] || [[ "$pick" -lt 1 ]] || [[ "$pick" -gt ${#REPORT_CLEANUP_BATCHES[@]} ]]; then
    echo "Cancelled. Nothing was changed."
    return 0
  fi
  local batch="${REPORT_CLEANUP_BATCHES[$((pick - 1))]}"
  if [[ ! "$batch" =~ ^[0-9]{8}-[0-9]{6}-[0-9a-f]{8}$ ]]; then
    echo -e "${RED}Unexpected batch name — nothing was changed.${RESET}" >&2
    return 0
  fi

  local out="" rc=0 line tab=$'\t' restorable=""
  out=$(python3 "$REPORT_CLEANUP_HELPER" restore --batch "$batch") || rc=$?
  echo ""
  while IFS= read -r line; do
    if [[ "$line" == "RESTORABLE${tab}"* ]]; then
      restorable="${line#"RESTORABLE${tab}"}"
    else
      echo "$line"
    fi
  done <<< "$out"
  if [[ $rc -ne 0 || ! "$restorable" =~ ^[0-9]+$ ]]; then
    echo -e "${RED}Restore plan failed (exit $rc) — nothing was changed.${RESET}" >&2
    return 0
  fi
  [[ "$restorable" -eq 0 ]] && return 0

  echo -ne "${YELLOW}Type 'yes' to restore ${restorable} run report(s) from batch $batch (nothing is overwritten; anything else cancels): ${RESET}"
  local confirm=""
  prompt_read confirm
  if [[ "$confirm" != "yes" ]]; then
    echo "Cancelled. Nothing was changed."
    return 0
  fi
  rc=0
  python3 "$REPORT_CLEANUP_HELPER" restore --batch "$batch" --yes || rc=$?
  if [[ $rc -ne 0 ]]; then
    echo -e "${YELLOW}Warning: restore finished with problems (exit $rc) — see above. Nothing was overwritten or deleted.${RESET}" >&2
  fi
  return 0
}

cleanup_run_reports() {
  if [[ ! -f "$REPORT_CLEANUP_HELPER" ]]; then
    echo -e "${RED}Run-report cleanup helper not found at $REPORT_CLEANUP_HELPER — nothing was changed. Set COPILOT_REPORT_CLEANUP_HELPER or re-run the installer.${RESET}" >&2
    pause_for_menu
    return 0
  fi
  if ! command -v python3 >/dev/null 2>&1; then
    echo -e "${RED}python3 not found — nothing was changed.${RESET}" >&2
    pause_for_menu
    return 0
  fi
  while true; do
    echo -e "\n${BOLD}Run reports and private RTK data — recoverable quarantine (no disk space is freed)${RESET}"
    echo -e "  ${BOLD}1)${RESET} Preview, then quarantine finalized run reports (all workspaces)"
    echo -e "  ${BOLD}2)${RESET} List quarantine batches"
    echo -e "  ${BOLD}3)${RESET} Restore a quarantine batch"
    echo -e "  ${BOLD}4)${RESET} ${RED}Permanently purge ONE quarantine batch (frees disk space; IRREVERSIBLE)${RESET}"
    echo -e "  ${BOLD}b)${RESET} Back to the session menu (default)"
    echo -ne "${BOLD}Choose [1, 2, 3, Enter/b = back]: ${RESET}"
    local choice=""
    prompt_read choice
    case "$choice" in
      1) report_cleanup_preview_apply ;;
      2) report_cleanup_list || true ;;
      3) report_cleanup_restore ;;
      4)
        echo -e "\n${BOLD}Quarantined run reports — PERMANENT purge (frees disk space; IRREVERSIBLE)${RESET}"
        quarantine_purge_pick "run-report" "$REPORT_CLEANUP_HELPER"
        ;;
      ""|b|B|q|Q) return 0 ;;
      *) echo "Invalid selection." ;;
    esac
  done
}

# Shown when there are no saved sessions at all. Enter (or n) starts a new
# session exactly like before; p refreshes subagent models, r manages old
# run reports and x permanently purges one quarantined-session batch, all
# coming back here instead of launching anything; q quits. (x is listed but
# deliberately not advertised in the short prompt, like r -> 4.)
empty_session_menu() {
  while true; do
    echo -e "\n${DIM}No saved sessions found.${RESET}"
    echo -e "  ${BOLD}${GREEN}n)${RESET} New session (default)"
    echo -e "  ${BOLD}${CYAN}p)${RESET} Refresh subagent models from current prices"
    echo -e "  ${BOLD}${YELLOW}r)${RESET} Clean run reports and private RTK data (recoverable)"
    echo -e "  ${BOLD}${RED}x)${RESET} Permanently purge a quarantined-session batch (irreversible)"
    echo -e "  ${BOLD}q)${RESET} Quit"
    echo -ne "${BOLD}Start a new session? [Enter/n = new, p, r, q]: ${RESET}"
    local choice=""
    prompt_read choice
    case "$choice" in
      p|P)
        refresh_model_routing
        ;;
      r|R)
        cleanup_run_reports
        ;;
      x|X)
        purge_session_quarantine
        ;;
      q|Q)
        echo "Bye!"
        return 0
        ;;
      ""|n|N)
        echo -e "${DIM}Starting a new one...${RESET}\n"
        run_copilot "" "$@"
        return 0
        ;;
      *)
        echo "Invalid selection."
        ;;
    esac
  done
}

# --- Interactive menu ---
select_session() {
  echo -ne "${BOLD}Select session to resume (or n/q): ${RESET}"
  local choice=""
  prompt_read choice

  case "${choice:-}" in
    q|Q)
      echo "Bye!"
      ;;
    a|A)
      SHOW_ALL=true
      if list_sessions; then
        select_session "$@"
      else
        echo -e "\n${DIM}No sessions found.${RESET}"
      fi
      ;;
    n|N)
      run_copilot "" "$@"
      ;;
    d|D)
      delete_session
      if list_sessions; then
        select_session "$@"
      else
        echo -e "\n${DIM}No sessions left. Starting a new one...${RESET}\n"
        run_copilot "" "$@"
      fi
      ;;
    c|C)
      cleanup_empty_sessions
      # Never auto-launch a new session after cleanup.
      if list_sessions; then
        select_session "$@"
      elif [[ "$SHOW_ALL" != "true" ]]; then
        SHOW_ALL=true
        if list_sessions; then
          echo -e "${DIM}  No sessions left for current directory. Showing all.${RESET}\n"
          select_session "$@"
        else
          echo -e "\n${DIM}No sessions left. Run copilot-s again to start a new one.${RESET}"
        fi
      else
        echo -e "\n${DIM}No sessions left. Run copilot-s again to start a new one.${RESET}"
      fi
      ;;
    p|P)
      refresh_model_routing
      # Never auto-launch a new session after a model refresh.
      if list_sessions; then
        select_session "$@"
      else
        empty_session_menu "$@"
      fi
      ;;
    r|R)
      cleanup_run_reports
      # Never auto-launch a new session after a run-report cleanup.
      if list_sessions; then
        select_session "$@"
      else
        empty_session_menu "$@"
      fi
      ;;
    x|X)
      purge_session_quarantine
      # Never auto-launch a new session after a purge.
      if list_sessions; then
        select_session "$@"
      else
        empty_session_menu "$@"
      fi
      ;;
    *)
      if [[ "${choice:-}" =~ ^[0-9]+$ ]]; then
        local sid
        sid=$(sed -n "${choice}p" "$FILTERED_FILE" 2>/dev/null | cut -d'|' -f1) || true
        if [[ -n "${sid:-}" ]]; then
          echo -e "${GREEN}Resuming session ${sid:0:8}…${RESET}"
          run_copilot "$sid" "$@"
        else
          echo "Invalid selection."
        fi
      else
        echo "Invalid selection."
      fi
      ;;
  esac
}

# --- Ensure the task-usage-reporting install marker exists ---
# Must run BEFORE the first-ever `copilot` invocation from this script so
# that a brand-new install's very first session counts (its events land
# after installed_epoch), while any sessions that already existed before
# this feature was ever used remain excluded (their events predate it).
ensure_task_install_marker() {
  if [[ ! -f "$TASK_REPORT_HELPER" ]]; then
    echo -e "${YELLOW}Warning: task report helper not found at $TASK_REPORT_HELPER — usage reporting is disabled until this is fixed. Set COPILOT_TASK_REPORT_HELPER or re-run the installer.${RESET}" >&2
    return 0
  fi
  command -v python3 >/dev/null 2>&1 || { echo -e "${YELLOW}Warning: python3 not found — task usage reporting disabled.${RESET}" >&2; return 0; }
  python3 "$TASK_REPORT_HELPER" ensure-marker >/dev/null 2>&1 || true
}

# --- Help / usage ---
# Safe to run at any time: never touches sessions, never prompts, never
# launches `copilot`. Exits immediately after printing.
show_help() {
  echo -e "$(cat <<EOF
${BOLD}copilot-s${RESET} — Copilot Session Manager (v${COPILOT_S_VERSION})

Lists and manages local Copilot CLI sessions, with per-directory filtering,
resume/rename/delete, and optional per-task usage reporting.

${BOLD}Usage:${RESET}
  copilot-s                     List sessions relevant to the current directory
  copilot-s --all | -a          List every session, across all directories
  copilot-s --report TASK_ID    Print/regenerate the usage report for a task
  copilot-s --task TASK_ID      Alias for --report
  copilot-s --rtk [...]         Launch this one session in RTK mode (see below)
  copilot-s --session-report SESSION_ID
                                Print the per-launch report for a session
                                (read-only; normal and RTK launches by mode)
  copilot-s --help | -h         Show this help and exit
  copilot-s --version | -v      Show the version and exit

${BOLD}Features:${RESET}
  - Copilot launches use Auto with the Balance tier; organization model
    policies may still restrict routing
  - Resume, rename, or delete sessions (single/range/multi-select)
  - Clean up empty sessions (menu \`c\`): previews never-used, unnamed
    sessions older than 24h in the listed scope (answer \`y\` to the
    first prompt to also include recent ones, default No) and, after you
    type \`yes\`, moves them to ~/.copilot-s-quarantine (recoverable, never
    deleted). Restore with:
    copilot-session-cleanup.py restore --batch <batch>
  - Clean run reports and private RTK data (menu \`r\`, also offered when
    there are no sessions): previews FINALIZED per-launch run reports of
    ALL workspaces (completed/copilot-error/interrupted, finalized more
    than 24h ago unless you opt in to recent ones; active, unfinalized,
    report-failure or uncertain runs are always kept) with their private
    raw/ data (RTK history DB, tee/recall, Copilot usage file) and matching
    RTK publication, and after you type \`yes\` MOVES them to
    ~/.copilot/copilot-s-report-quarantine/<batch>/ (recoverable, never
    deleted — no disk space is freed). The submenu lists and restores
    batches; or use:
    copilot-report-cleanup.py list
    copilot-report-cleanup.py restore --batch <batch> [--yes]
  - Permanently purge ONE quarantine batch (menu \`x\` for quarantined
    sessions, submenu \`r\` -> \`4\` for quarantined run reports): only fully
    settled batches (every entry moved or skipped, at least one moved,
    nothing changed since it was quarantined) are offered. The helper shows
    the exact inventory and the ESTIMATED reclaimable space, then deletes
    only after you type the exact phrase it shows (PURGE <kind> <batch>
    <snapshot id>) on the terminal. IRREVERSIBLE; never automatic; no
    yes/force bypass. Also available as:
    copilot-session-cleanup.py purge-list | purge-preview --batch <batch>
      | purge --batch <batch>   (same for copilot-report-cleanup.py)
  - Refresh subagent models (menu \`p\`, also offered when there are no
    sessions): fetches the CURRENT official GitHub Copilot prices, shows
    the current vs proposed model/effort/context per subagent route with
    rates, reasons and evidence, and applies local overrides only after
    you type \`yes\` (default No). Shipped defaults are never edited; your
    own /subagents values are never overwritten. Undo with:
    copilot-model-refresh.py reset --yes
  - Prompts to keep/rename/delete a session when \`copilot\` exits
  - For sessions created by copilot-s from now on: shows the context fill
    last observed before a compaction and the successful compaction count
    on exit and in the session list (older sessions are never scanned)
  - Per-task usage reports (\`--report\`/\`--task\`), attributed via the current
    git branch (KEY-123-style IDs only) or an interactive prompt that also
    accepts free-form task names
  - Per-launch session reports for EVERY launch (normal and RTK): exact
    session link or "unknown", exit status, wall clock, model calls/tokens
    from the own OTEL file of the launch, an estimated cost frozen with official
    list prices, and RTK aggregates. Metadata only (no prompts, commands or
    output), under ~/.copilot/session-reports (0700/0600). Inspect with
    \`copilot-s --session-report SESSION_ID\` or copilot-session-report.py
    launch|session|compare|mark-outcome.

${BOLD}RTK mode (--rtk):${RESET}
  Opt-in per launch, never remembered. Requires rtk ${SUPPORTED_RTK_LABEL} exactly
  and refuses to launch if RTK user config/filters/trust store or an
  existing \`rtk hook\` Copilot configuration could alter results. A
  session-local hook (--plugin-dir, never installed) rewrites only simple
  test/build commands (e.g. \`cargo test\`, \`pytest\`, \`npm run build\`) to
  \`rtk <command>\`; anything with pipes, redirects, quotes, variables or
  other shell syntax, and review/exact-output tools (git, diff, grep, cat),
  runs unchanged. Copilot permissions are NOT widened: the rewritten
  \`rtk ...\` command is checked by your normal rules and may prompt. If RTK
  fails during the session the command is denied (never run unfiltered).
  Raw RTK data (its history DB stores command lines; tee/recall keep
  output) stays in the private raw/ folder of the launch and is never deleted
  automatically.

${BOLD}Environment:${RESET}
  COPILOT_TASK_REPORTS_DIR       Override where task usage reports are written
  COPILOT_TASK_REPORT_HELPER     Override the path to copilot-task-report.py
  COPILOT_SESSION_CLEANUP_HELPER Override the path to copilot-session-cleanup.py
  COPILOT_REPORT_CLEANUP_HELPER  Override the path to copilot-report-cleanup.py
  COPILOT_MODEL_REFRESH_HELPER   Override the path to copilot-model-refresh.py
  COPILOT_SESSION_REPORT_HELPER  Override the path to copilot-session-report.py
  COPILOT_SESSION_REPORTS_DIR    Override where per-launch run records are kept
  COPILOT_S_RTK_PLUGIN_DIR       Override the RTK hook plugin directory (absolute)

Verify install with: copilot-s --help
EOF
)"
}

# --- Manually regenerate/display a task usage report ---
show_task_report() {
  local task_id="${1:-}"
  if [[ -z "$task_id" ]]; then
    echo -e "${RED}Usage:${RESET} copilot-s --report TASK_ID" >&2
    return 1
  fi
  if [[ ! -f "$TASK_REPORT_HELPER" ]]; then
    echo -e "${RED}task report helper not found:${RESET} $TASK_REPORT_HELPER" >&2
    return 1
  fi
  command -v python3 >/dev/null 2>&1 || { echo -e "${RED}python3 not found.${RESET}" >&2; return 1; }
  python3 "$TASK_REPORT_HELPER" report -- "$task_id"
}

# --- Entry point ---
main() {
  # --help/--version: handle first, except inside an option operand or after --.
  # Never prompts, never touches session/marker state, never launches
  # `copilot`.
  local arg skip_operand=false
  local want_session_report_value=false found_session_report=false session_report_id=""
  for arg in "$@"; do
    if [[ "$want_session_report_value" == "true" ]]; then
      want_session_report_value=false
      if [[ "$arg" != -* ]]; then
        session_report_id="$arg"
        continue
      fi
    fi
    if [[ "$skip_operand" == "true" ]]; then
      skip_operand=false
      [[ "$arg" != "--" ]] && continue
    fi
    case "$arg" in
      --) break ;;
      --help|-h) show_help; exit 0 ;;
      --version|-v) echo "copilot-s ${COPILOT_S_VERSION}"; exit 0 ;;
      --session-report) found_session_report=true; want_session_report_value=true; continue ;;
      --session-report=*) found_session_report=true; session_report_id="${arg#--session-report=}"; continue ;;
    esac
    if copilot_option_takes_value "$arg"; then
      skip_operand=true
    fi
  done

  # --session-report SESSION_ID: read-only, before any setup side effect.
  if [[ "$found_session_report" == "true" ]]; then
    show_session_report "$session_report_id"
    exit $?
  fi

  # Past informational-argument handling: this is a real session-manager
  # invocation, so set up OTEL telemetry (has filesystem side effects) now.
  setup_otel

  # Always ensure the install marker exists before anything else, so the
  # very first `copilot` invocation this script ever makes is guaranteed to
  # land after installed_epoch (first post-install session counts; nothing
  # historical/pre-existing does).
  ensure_task_install_marker

  # --report TASK_ID / --task TASK_ID: regenerate/print a task usage report
  # and exit immediately, bypassing the session manager entirely. Scan the
  # options before -- (not just $1), respecting native value operands.
  # Neither wrapper flag must ever reach `copilot` as an option.
  local report_task_id="" found_report=false
  local remaining=()
  local n=$#
  local idx=0
  while [[ $idx -lt $n ]]; do
    idx=$((idx + 1))
    local arg="${!idx}"
    if [[ "$arg" == "--" ]]; then
      while [[ $idx -le $n ]]; do
        remaining+=("${!idx}")
        idx=$((idx + 1))
      done
      break
    elif copilot_option_takes_value "$arg"; then
      remaining+=("$arg")
      local operand_idx=$((idx + 1))
      if [[ $operand_idx -le $n && "${!operand_idx}" != "--" ]]; then
        remaining+=("${!operand_idx}")
        idx=$operand_idx
      fi
      continue
    fi
    if [[ "$arg" == "--report" || "$arg" == "--task" ]]; then
      found_report=true
      local next_idx=$((idx + 1))
      if [[ $next_idx -le $n ]]; then
        local next_val="${!next_idx}"
        # Only consume the next token as the value if it doesn't itself
        # look like a recognized flag (e.g. `copilot-s --task --all` must
        # not silently swallow `--all` as the task ID and drop it). A
        # valid task ID can never start with '-' anyway (rejected by the
        # normalizer), so this can never misclassify a real value.
        if [[ "$next_val" != -* ]]; then
          report_task_id="$next_val"
          idx=$next_idx
        fi
      fi
      continue
    elif [[ "$arg" == --report=* ]]; then
      found_report=true
      report_task_id="${arg#--report=}"
      continue
    elif [[ "$arg" == --task=* ]]; then
      found_report=true
      report_task_id="${arg#--task=}"
      continue
    elif [[ "$arg" == "--all" || "$arg" == "-a" ]]; then
      SHOW_ALL=true
      continue
    elif [[ "$arg" == "--rtk" ]]; then
      # Wrapper-only, per-launch flag: consumed here, never passed to copilot.
      RTK_MODE=true
      continue
    fi
    remaining+=("$arg")
  done

  if [[ "$found_report" == "true" ]]; then
    show_task_report "$report_task_id"
    exit $?
  fi

  # RTK mode: read-only preflight before the menu, so a refusal happens
  # before any session choice or prompt (the full check, including a smoke
  # test of the real `rtk hook copilot`, runs again right before launch).
  if [[ "$RTK_MODE" == "true" ]]; then
    if [[ ! -f "$SESSION_REPORT_HELPER" ]] || ! command -v python3 >/dev/null 2>&1; then
      echo -e "${RED}RTK mode needs python3 and copilot-session-report.py ($SESSION_REPORT_HELPER). Nothing was launched.${RESET}" >&2
      exit 1
    fi
    if ! python3 "$SESSION_REPORT_HELPER" preflight --mode rtk --cwd "$PWD" --plugin-dir "$RTK_PLUGIN_DIR" >/dev/null; then
      echo -e "${RED}RTK mode refused (see above). Nothing was launched.${RESET}" >&2
      exit 1
    fi
  fi

  set -- "${remaining[@]+"${remaining[@]}"}"

  echo -e "${BOLD}${CYAN}┌──────────────────────────────┐${RESET}"
  echo -e "${BOLD}${CYAN}│  Copilot Session Manager     │${RESET}"
  echo -e "${BOLD}${CYAN}└──────────────────────────────┘${RESET}"
  if [[ "$RTK_MODE" == "true" ]]; then
    echo -e "  ${BOLD}${YELLOW}[RTK mode]${RESET} ${DIM}this launch only — rtk ${SUPPORTED_RTK_LABEL} hook for simple test/build commands${RESET}"
  else
    echo -e "  ${DIM}[normal mode]${RESET}"
  fi

  if list_sessions; then
    select_session "$@"
  else
    # No local sessions — fall back to all
    SHOW_ALL=true
    if list_sessions; then
      echo -e "${DIM}  No sessions for current directory. Showing all.${RESET}\n"
      select_session "$@"
    else
      # Not an automatic launch any more: Enter starts a new session as
      # before, while p (model refresh) returns here instead of launching.
      empty_session_menu "$@"
    fi
  fi
}

main "$@"
